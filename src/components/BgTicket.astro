---
// The background-removal job ticket, shared by every locale's pages.
// All furniture text comes from src/locales/bg.js (en is the source of
// truth; es / pt-BR pending human review, see TRANSLATIONS.md). The
// data-locale attribute on the section is how the island
// (src/scripts/remove-bg.js) picks its runtime strings.
import { BG_STRINGS } from '../locales/bg.js';

interface Props {
  locale?: string;
  full?: boolean;
}
const { locale = 'en', full = false } = Astro.props;
const ui = (BG_STRINGS[locale] || BG_STRINGS.en).ui;
const resultHeading = full ? ui.resultHeadingFull : ui.resultHeading;
const downloadLabel = full ? ui.downloadLabelFull : ui.downloadLabel;
---

<section class="ticket mt-6 p-5 sm:p-7" id="bg-tool" data-locale={locale}>
  <div id="bg-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label={ui.trayAria}>
    <p class="font-display text-xl font-bold">{ui.trayTitle}</p>
    <p class="font-mono text-xs text-ink-soft mt-2">{ui.traySub}</p>
    <input id="bg-file" type="file" accept="image/*" class="hidden" />
  </div>

  <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
    <div>
      <img id="bg-preview" alt={ui.previewAlt} class="hidden w-full border border-line bg-paper-deep object-contain max-h-96" />
    </div>
    <div>
      <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">{ui.specHeading}</h2>
      <dl id="bg-spec" class="mt-2">
        <div class="spec-row"><dt>{ui.specNoneKey}</dt><dd>{ui.specNoneValue}</dd></div>
      </dl>
      <button id="bg-run" class="btn-primary w-full mt-5" type="button" disabled>{ui.runButton}</button>
      <p id="bg-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">{ui.initialStatus}</p>
    </div>
  </div>

  <div id="bg-nosubject" class="hidden mt-6 border border-accent p-4 bg-paper">
    <p class="font-bold">{ui.noSubjectHeading}</p>
    <p class="text-ink-soft mt-1">{ui.noSubjectBody}</p>
  </div>

  <div id="bg-result" class="hidden mt-8">
    <div class="tear pt-5 flex items-center gap-4 flex-wrap">
      <h2 class="font-display text-2xl font-bold">{resultHeading}</h2>
      <span class="stamp" id="bg-stamp">{ui.stamp}</span>
    </div>
    <div id="bg-compare" class="compare checker border border-line mt-4 max-w-2xl">
      <img id="bg-after-img" alt={ui.afterAlt} />
      <div class="absolute inset-0" id="bg-before-wrap">
        <img id="bg-before-img" alt={ui.beforeAlt} class="w-full" />
      </div>
      <div class="divider" id="bg-divider" style="left:50%"></div>
    </div>
    <p class="font-mono text-xs text-ink-soft mt-2">{ui.compareHint}</p>
    <input id="bg-range" type="range" min="0" max="100" value="50" class="w-full max-w-2xl mt-2" aria-label={ui.rangeLabel} />
    <p id="bg-times" class="font-mono text-sm mt-4"></p>
    <a id="bg-download" class="btn-primary inline-block no-underline mt-3" href="#" download>{downloadLabel}</a>
  </div>
</section>
