---
// The bench-block mark (logo concept B, owner-approved): a bold
// lowercase b in a hard square. The letter is the real IBM Plex Sans
// Bold glyph as a vector path (extracted by tools/make-logo.mjs from
// the official font), so the mark is the site's own typeface, not a
// drawing of it. Props: size in px; tone 'ink' (default) or 'paper'
// for use on the ink block; class for layout extras.
const { size = 30, tone = 'ink', class: klass = '' } = Astro.props;
const d = 'M9.57 25.39L9.57 6.2L13.41 6.2L13.41 14.06L13.54 14.06Q13.82 12.92 14.85 12.19Q15.87 11.46 17.19 11.46Q18.93 11.46 20.08 12.28Q21.24 13.1 21.83 14.68Q22.43 16.26 22.43 18.57Q22.43 20.88 21.83 22.47Q21.24 24.07 20.08 24.88Q18.93 25.7 17.19 25.7Q15.87 25.7 14.85 24.96Q13.82 24.22 13.54 23.11L13.41 23.11L13.41 25.39ZM15.92 22.59Q17.01 22.59 17.72 21.81Q18.44 21.03 18.44 19.76L18.44 17.4Q18.44 16.11 17.72 15.34Q17.01 14.58 15.92 14.58Q15.2 14.58 14.63 14.81Q14.06 15.04 13.73 15.5Q13.41 15.95 13.41 16.57L13.41 20.59Q13.41 21.21 13.73 21.67Q14.06 22.12 14.63 22.35Q15.2 22.59 15.92 22.59Z';
const color = tone === 'paper' ? '#faf6ee' : '#1b2634';
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class={klass} style="flex:none"><rect x="1.75" y="1.75" width="28.5" height="28.5" fill="none" stroke={color} stroke-width="3.5"/><path d={d} fill={color}/></svg>
