---
import Base from '../layouts/Base.astro';
import BgTicket from '../components/BgTicket.astro';
import LogoMark from '../components/LogoMark.astro';

// The homepage ledger: every live door, grouped the way the workshop
// is organised. Rows are counted from this data, so the numbers the
// page prints (in the facts ledger and the section head) are the
// numbers the page contains.
const families = [
  {
    name: 'Background removal',
    tools: [
      { name: 'Remove background', href: '/remove-background/', live: true, note: 'Full size cutouts. The program runs in your browser; the first run loads it (44.3 MB in 11 checked pieces, printed before it loads).' },
      { name: 'Batch remove background', href: '/batch-remove-background/', live: true, note: 'A whole folder of photos cut out in one run, one program load for the batch, one ZIP of full-size PNGs out.' },
      { name: 'Free background remover, full resolution', href: '/remove-background-full-resolution/', live: true, note: 'The full-size promise in plain words, with the dated facts about the famous alternative that closes 1 December.' },
    ],
  },
  {
    name: 'PDF jobs',
    tools: [
      { name: 'Compress PDF to a size', href: '/compress-pdf/', live: true, note: 'Pick a target, 200 KB, 500 KB, 2 MB or your own number, and the page works to land under it.' },
      { name: 'Compress PDF to 200 KB', href: '/compress-pdf-to-200kb/', live: true, note: 'The tight-portal preset: the same tool, with the 200 KB target already set.' },
      { name: 'Compress PDF to 50 KB', href: '/compress-pdf-to-50kb/', live: true, note: 'The visa-portal preset: the same tool, with the 50 KB target already set.' },
      { name: 'Compress PDF to 100 KB', href: '/compress-pdf-to-100kb/', live: true, note: 'The form-portal preset: the same tool, with the 100 KB target already set.' },
      { name: 'Compress PDF to 500 KB', href: '/compress-pdf-to-500kb/', live: true, note: 'The email-and-boards preset: the same tool, with the 500 KB target already set.' },
      { name: 'Compress PDF to 1 MB', href: '/compress-pdf-to-1mb/', live: true, note: 'The attachment preset: the same tool, with the 1 MB target already set.' },
      { name: 'Compress PDF, strong', href: '/compress-pdf-strong/', live: true, note: 'No target: the deep end of the shrink ladder, smallest honest result, the photo trade printed on the result.' },
      { name: 'Merge PDF', href: '/merge-pdf/', live: true, note: 'As many files as your device can hold, in your order. In our tests, merging 25 files took 71 milliseconds.' },
      { name: 'Interleave PDF', href: '/interleave-pdf/', live: true, note: 'Deal two PDFs together a page at a time, A1 B1 A2 B2: the duplex scan repair, with a back-to-front option for the second file.' },
      { name: 'Split PDF', href: '/split-pdf/', live: true, note: 'Pull out a page range as one file, take every page as its own PDF, or cut parts under a size you set.' },
      { name: 'Remove and organise pages', href: '/organize-pdf/', live: true, note: 'See every page, take pages out, drag the rest into order, copy a page. Pages move inside the file; nothing is rebuilt.' },
      { name: 'Sign PDF', href: '/sign-pdf/', live: true, note: 'Your own signature on your own document, drawn into the page. Plainly scoped: no requests to others, no certificates.' },
      { name: 'Flatten PDF', href: '/flatten-pdf/', live: true, note: 'Bake a filled form\'s answers into the pages, so the file displays and prints the same everywhere.' },
      { name: 'Protect PDF', href: '/protect-pdf/', live: true, note: 'Put a real password on your own PDF, AES-256, without the file or the password leaving this page.' },
      { name: 'Unlock PDF', href: '/unlock-pdf/', live: true, note: 'Take the password off your own PDF: type the open password, or let the permission switches come off on their own.' },
      { name: 'Rotate PDF', href: '/rotate-pdf/', live: true, note: 'Turn every page, or one range, a quarter or half turn. The file carries the turn; nothing is redrawn.' },
      { name: 'Add page numbers', href: '/pdf-page-numbers/', live: true, note: 'Page numbers drawn onto the pages: bottom centre, outside corner or top, from the number you start at.' },
      { name: 'Watermark PDF', href: '/watermark-pdf/', live: true, note: 'Stamp DRAFT or your own words across the pages, diagonal or straight, at the strength you pick.' },
      { name: 'Extract images from PDF', href: '/extract-images-pdf/', live: true, note: 'Pull the pictures stored in a PDF out as files, with a report naming anything that cannot come out.' },
      { name: 'View and strip PDF metadata', href: '/pdf-metadata/', live: true, note: 'See the details a PDF stores about itself, exactly as stored. Fix the title or author, or wipe the whole label card.' },
      { name: 'JPG to PDF', href: '/jpg-to-pdf/', live: true, note: 'Pictures into one PDF, one per page, in your order, exactly as stored.' },
      { name: 'PDF to JPG', href: '/pdf-to-jpg/', live: true, note: 'Every page as a picture, screen or print size, in one ZIP in page order.' },
      { name: 'Read a scan (OCR)', href: '/ocr-pdf/', live: true, note: 'Scanned pages read at 300 DPI: checkable text plus a searchable PDF. 96% character accuracy on the test invoice.' },
    ],
  },
  {
    name: 'Batch and workflows',
    tools: [
      { name: 'Batch compress PDF', href: '/batch-compress-pdf/', live: true, note: 'A folder of PDFs worked to one target size in a single run, per-file results, one ZIP out. The job the suites sell as a paid extra.' },
      { name: 'Batch merge PDF', href: '/batch-merge-pdf/', live: true, note: 'Pick a whole folder, sort the tray by file name, and merge it into one file.' },
      { name: 'Batch split PDF', href: '/batch-split-pdf/', live: true, note: 'One page range cut from every file in the folder, in a single run.' },
      { name: 'Workflows', href: '/workflows/', live: true, note: 'Chain the tools (merge, then shrink, then sign), save the chain in your browser, and run it on the next folder.' },
      { name: 'Preset chains', href: '/presets/', live: true, note: 'Ready-made chains for the weekly jobs: invoice pack, portal pack, paid pack, seller photos.' },
    ],
  },
  {
    name: 'Image jobs',
    tools: [
      { name: 'Compress image to exact KB', href: '/compress-image/', live: true, note: 'The tool the big sites do not offer: a photo at the exact size a form or shop asks for.' },
      { name: 'Compress image to 50 KB', href: '/compress-image-to-50kb/', live: true, note: 'The form and seller preset: the same tool, with the 50 KB target already set.' },
      { name: 'Batch compress images', href: '/batch-compress-images/', live: true, note: 'A folder of photos worked to one exact KB target in a single run, one ZIP out.' },
      { name: 'Batch convert images', href: '/batch-convert-images/', live: true, note: 'A folder converted to JPG, PNG or WebP at one quality, with an optional maximum width.' },
      { name: 'Read the words in a photo (OCR)', href: '/ocr-image/', live: true, note: 'Words out of a photo or screenshot as text you can check, copy and download. English, Spanish and Portuguese; 99% of characters right on the clean test picture.' },
      { name: 'Resize image', href: '/resize-image/', live: true, note: 'A photo to exact pixels: passport and post presets, percent, or your own numbers. The result prints dimensions and bytes, before and after.' },
      { name: 'Batch resize images', href: '/batch-resize-images/', live: true, note: 'A folder to one pixel size in a single run, every photo keeping its own format. Tested with 50 files in one run.' },
      { name: 'HEIC to JPG', href: '/heic-to-jpg/', live: true, note: 'An iPhone HEIC photo as a JPG, PNG or WebP, full size and upright. The brightness-range change is stated before the run.' },
      { name: 'PNG to JPG', href: '/png-to-jpg/', live: true, note: 'One PNG as a JPG for forms and shops. See-through parts are painted over a colour you pick.' },
      { name: 'JPG to PNG', href: '/jpg-to-png/', live: true, note: 'One JPG as an exact PNG, for doors that require PNG.' },
      { name: 'WebP to JPG', href: '/webp-to-jpg/', live: true, note: 'One WebP as a JPG that everything opens.' },
      { name: 'JPG to WebP', href: '/jpg-to-webp/', live: true, note: 'One JPG as a WebP for websites, usually the lightest of the three.' },
      { name: 'PNG to WebP', href: '/png-to-webp/', live: true, note: 'One PNG as a WebP for websites, transparency kept.' },
      { name: 'WebP to PNG', href: '/webp-to-png/', live: true, note: 'One WebP as an exact PNG, transparency kept.' },
    ],
  },
  {
    name: 'Check a file',
    tools: [
      { name: 'Size checker', href: '/size-checker/', live: true, note: 'Exact bytes, real format, dimensions, pages or duration, lined up against the doors portals set.' },
    ],
  },
];
const allTools = families.flatMap((f) => f.tools);
const liveCount = allTools.filter((t) => t.live).length;
const planCount = allTools.length - liveCount;

// The homepage runs the flagship tool in its hero, so it carries the
// same schema furniture as a tool page (milestone 7): a HowTo
// transcribed from the tool's own visible labels, and an FAQPage
// transcribed from the Questions section rendered below.
const faq = [
  {
    q: 'Where does my file go?',
    a: 'Nowhere. Every tool here runs inside your browser, on your device. Files are read into the page, worked on, and offered back as a download; nothing is uploaded, so your file never reaches a server. The pages themselves are served by a host, Cloudflare Pages, named on the privacy page.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes, at full size, with no account and no daily counter. The site will be paid for by ads on the pages; no ads run yet. The written commitment is on the what free means here page.',
  },
  {
    q: 'Why does the background tool load a program first?',
    a: 'The removal program (44.3 MB, in 11 checked pieces) is the tool itself. Your browser loads it once, checks it piece by piece, and saves it, so later visits start at once. Your photo is never sent anywhere.',
  },
  {
    q: 'What else can I do here?',
    a: 'Compress a PDF to an exact size, merge and split PDFs, shrink a photo to an exact KB, read a scan, sign and flatten forms, and run whole folders through the batch tools and saved workflows. Every door is listed in the ledger above.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to remove the background from a photo',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Pick a photo', text: 'Drop a photo on the tray, or click to pick one. Your photo is read into this page and never uploaded.' },
    { '@type': 'HowToStep', position: 2, name: 'Remove the background', text: "Press 'Remove the background'. The first time, your browser loads the removal program (44.3 MB, in 11 pieces it checks one by one); later visits reuse the saved copy." },
    { '@type': 'HowToStep', position: 3, name: 'The subject is cut out', text: 'The program reads the photo, works out which pixels belong to the subject, and writes a new picture where the rest is transparent.' },
    { '@type': 'HowToStep', position: 4, name: 'Compare and download', text: 'Drag on the picture to compare before and after, then download the cutout (PNG) at full size.' },
  ],
});
---

<Base title="Benchzy: file jobs, done on your device" description="Free file tools that run inside your browser. Remove a background, compress a PDF to an exact size, shrink a photo to an exact KB. No uploads, no accounts.">
  <div class="mx-auto max-w-5xl px-4">
    <div class="hero-grid">
      <div>
        <div class="flex items-start justify-between gap-4">
          <p class="kicker">File tools that run in your browser · <b>Nothing is uploaded</b></p>
          <span class="hidden md:block -mt-2"><LogoMark size={88} /></span>
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-tight tracking-tight">File jobs, done on your device.</h1>
        <p class="mt-5 text-lg leading-relaxed max-w-xl">
          Benchzy is a workshop of file tools that run inside your web browser. Your files are
          processed on your own device and are <strong>never uploaded</strong>. No accounts, no
          daily counters, no watermarks. No tricks at the download button.
        </p>
        <div class="fast-lane">
          <span class="fl-k">I need to…</span>
          <a href="/compress-image/">Shrink a photo for a form →</a>
          <a href="/heic-to-jpg/">My iPhone photo will not upload →</a>
          <a href="/compress-pdf-to-50kb/">Get files under a visa or portal limit →</a>
          <a href="/remove-background/">Cut out a product photo →</a>
        </div>
        <div class="mt-8 flex items-baseline gap-4 flex-wrap">
          <h2 class="font-mono text-xs font-semibold uppercase tracking-widest">Most-used tool · Remove background</h2>
          <span class="hand-note" aria-hidden="true">start here, it is free</span>
        </div>
        <BgTicket stack flush />
        <p class="font-mono text-xs text-ink-soft mt-4">
          The same tool on its own page: <a class="underline underline-offset-4" href="/remove-background/">remove background</a> ·
          a whole folder at once: <a class="underline underline-offset-4" href="/batch-remove-background/">batch remove background</a>
        </p>
      </div>

      <aside class="facts" aria-label="The standing facts">
        <h2>The standing facts</h2>
        <dl>
          <div class="spec-row"><dt>files sent to a server</dt><dd><span class="big">0</span>, by design</dd></div>
          <div class="spec-row"><dt>sign-up</dt><dd>none</dd></div>
          <div class="spec-row"><dt>daily limit</dt><dd>there is no job counter</dd></div>
          <div class="spec-row"><dt>tool pages working today</dt><dd>{liveCount}</dd></div>
          <div class="spec-row"><dt>price</dt><dd>free; ads will pay for the site, and none run yet</dd></div>
        </dl>
      </aside>
    </div>

    <section id="tools" class="mt-4">
      <div class="sec-head">
        <h2 class="font-display text-3xl font-semibold">All tools</h2>
        <span class="count">{liveCount} ready · {planCount} coming later</span>
        <span class="ml-auto hidden sm:block"><LogoMark size={40} /></span>
      </div>
      <div class="ledger" style="border-top:none">
        {families.map((fam) => (
          <>
            <div class="group-head">{fam.name}</div>
            {fam.tools.map((t) => t.live ? (
              <a class="job-row" href={t.href}>
                <span class="job-name">{t.name}</span>
                <span class="job-meta"><span class="status-live">Ready</span><span class="open">Open →</span></span>
                <span class="job-note">{t.note}</span>
              </a>
            ) : (
              <div class="job-row" aria-disabled="true">
                <span class="job-name">{t.name}</span>
                <span class="job-meta"><span class="status-plan">Coming later</span></span>
                <span class="job-note">{t.note}</span>
              </div>
            ))}
          </>
        ))}
      </div>
      <p class="mt-4 font-mono text-xs text-ink-soft">
        The same doors, grouped with the guides and comparisons around them, live on the
        <a class="underline underline-offset-4" href="/tools/">all tools page</a>.
      </p>
    </section>

    <section class="mt-12">
      <div class="sec-head"><h2 class="font-display text-3xl font-semibold">What “free” means here</h2></div>
      <div class="max-w-3xl mt-6">
        <p class="leading-relaxed">
          “Free” is not a tier. There is no bigger version of a tool waiting behind a payment,
          because the work happens on your device, not on our servers — there is almost nothing
          for a payment to buy. The written commitment, with the one real limit, is on the
          <a class="underline underline-offset-4" href="/what-free-means/">what free means here</a> page.
        </p>
      </div>
      <div class="points mt-6">
        <div class="row"><h3>Nothing leaves the device</h3><p>Every job runs inside the page, in your browser. Files sent to a server: <span class="font-mono text-sm">0, by design</span> — and you can watch the network panel while a job runs, on the <a class="underline underline-offset-4" href="/check-it-yourself/">check it yourself</a> page.</p></div>
        <div class="row"><h3>No job counter, no account</h3><p>There is no daily limit, because your jobs are not counted and cannot run out. (Visits to pages are counted, so we can see which tools get used; that count is named on the privacy page and never touches a job.) Nothing to sign up for, so nothing to cancel.</p></div>
        <div class="row"><h3>Full size, always</h3><p>The size you uploaded is the size you download. No small free size and no big paid size, because there are no tiers.</p></div>
        <div class="row"><h3>Honest when it can't</h3><p>If a tool cannot do a job well, the page says so before you pick a file — and if a job can't beat the original, you get your original back, with the sizes printed.</p></div>
      </div>
    </section>

    <section class="mt-12">
      <div class="sec-head"><h2 class="font-display text-3xl font-semibold">How a job runs</h2></div>
      <div class="steps mt-6">
        <div class="row"><span class="n">01</span><h3>Pick a file</h3><p>It is read into this page's memory, nowhere else.</p></div>
        <div class="row"><span class="n">02</span><h3>The page works</h3><p>An open-source program, loaded from this site, does the job on your device.</p></div>
        <div class="row"><span class="n">03</span><h3>Take it away</h3><p>Download the result. Close the page and the file is gone from memory.</p></div>
      </div>
      <p class="mt-4 font-mono text-xs text-ink-soft">Network witness: during a job, this page sends 0 files to any server. Watch it live, and learn the network-panel check, on the <a class="underline underline-offset-4" href="/check-it-yourself/">check it yourself</a> page.</p>
    </section>

    <section class="mt-12 mb-4">
      <div class="sec-head"><h2 class="font-display text-3xl font-semibold">Your workbench</h2></div>
      <div class="bench-block mt-6">
        <div class="b-head"><h3>Job notes</h3><span>Saved in your browser, nowhere else</span></div>
        <div class="b-body">
          <p class="leading-relaxed max-w-3xl">
            Jobs you finish and settings you choose are noted here, in this browser's own storage.
            The notes hold names and sizes only; your files themselves are never stored, so download
            your result before you close the page. Nothing here is sent to us or anyone else.
          </p>
          <p id="wb-empty" class="empty mt-4">No jobs yet. The tray is empty.</p>
          <ul id="wb-jobs" class="mt-2"></ul>
          <button id="wb-clear" class="textbtn mt-4" type="button">Clear the tray</button>
        </div>
      </div>
    </section>

    <section class="mt-12 mb-4">
      <div class="sec-head"><h2 class="font-display text-3xl font-semibold">Questions</h2></div>
      <div class="points mt-6">
        {faq.map((f) => (
          <div class="row"><h3>{f.q}</h3><p>{f.a}</p></div>
        ))}
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>

  <script>
    import '../scripts/remove-bg.js';
    import { renderJobs, clearJobs } from '../scripts/workbench.js';
    renderJobs(document.getElementById('wb-jobs'), document.getElementById('wb-empty'));
    document.getElementById('wb-clear').addEventListener('click', () => {
      clearJobs();
      renderJobs(document.getElementById('wb-jobs'), document.getElementById('wb-empty'));
    });
  </script>
</Base>
