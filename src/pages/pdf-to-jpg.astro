---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'Can I turn the pictures back into a document with selectable words?',
    a: 'No. Once a page is a picture, its words are part of the picture, the way words in a photograph are: they can be read by eye, not selected, copied or searched as text. If you need the words themselves, the read a scan (OCR) tool reads them out as text instead.',
  },
  {
    q: 'Which size should I pick?',
    a: 'Screen size (96 DPI) is the lighter picture, right for sharing, forms and screens: a Letter page comes out 816 x 1056 pixels. Print size (200 DPI) is the sharper picture, right for printing: a Letter page comes out 1700 x 2200 pixels, and the file is bigger for it.',
  },
  {
    q: 'How do I get the pictures?',
    a: 'A one-page PDF comes back as the picture itself. A longer document comes back as one ZIP holding one picture per page, named in page order, so the set stays together and stays sorted.',
  },
  {
    q: 'Where does my document go?',
    a: 'Nowhere. It is read into this page and its pages are drawn as pictures in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to turn PDF pages into pictures",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick the PDF", text: "Drop a PDF on the tray, or click to pick one. It stays on this device. The page reads its page count before anything runs." },
    { '@type': 'HowToStep', position: 2, name: "Pick the picture kind and size", text: "Choose JPG (saved at quality 92) or PNG (exact), and screen size (96 DPI) for sharing or print size (200 DPI) for printing." },
    { '@type': 'HowToStep', position: 3, name: "Turn the pages into pictures", text: "Press 'Turn the pages into pictures'. Every page is drawn as a picture, one at a time, in your browser." },
    { '@type': 'HowToStep', position: 4, name: "Download the pictures", text: "Take the finished pictures away: the picture itself for a one-page file, or one ZIP holding every page in order." },
  ],
});
---

<Base title="PDF to JPG: turn every page into a picture, free · Benchzy" description="Turn every page of a PDF into a JPG or PNG picture, at screen or print size, inside your browser. One picture per page, named in order; nothing is uploaded.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">PDF tools · convert</p>
      <h1 class="font-display text-4xl font-black mt-2">PDF to JPG</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Turn every page of a PDF into a picture: JPG or PNG, at screen size or print size.
        PNG has its own door too, the <a class="underline underline-offset-4 hover:text-accent-deep" href="/pdf-to-png/">PDF to PNG page</a>,
        for the exact copy on its own. Everything runs in your browser; the document is never uploaded. One plain warning
        first, because it cannot be undone: once a page is a picture, its words are part of
        the picture and cannot be selected or searched as text.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="pj-tool">
      <div id="pj-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick a PDF">
        <p class="font-display text-xl font-bold">Drop a PDF on the tray, or click to pick one</p>
        <p class="font-mono text-xs text-ink-soft mt-2">PDF · it stays on this device</p>
        <input id="pj-file" type="file" accept="application/pdf,.pdf" class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="pj-file" role="status"></p>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Picture kind</h2>
          <div class="mt-3 grid gap-3">
            <label class="flex items-baseline gap-2">
              <input type="radio" name="pj-format" value="jpg" checked />
              <span>JPG, saved at quality 92 (the lighter file)</span>
            </label>
            <label class="flex items-baseline gap-2">
              <input type="radio" name="pj-format" value="png" />
              <span>PNG, exact (the heavier file, nothing thrown away)</span>
            </label>
          </div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft mt-6">Picture size</h2>
          <div class="mt-3 grid gap-3">
            <label class="flex items-baseline gap-2">
              <input type="radio" name="pj-dpi" value="96" checked />
              <span>Screen size, 96 DPI (a Letter page becomes 816 x 1056 pixels)</span>
            </label>
            <label class="flex items-baseline gap-2">
              <input type="radio" name="pj-dpi" value="200" />
              <span>Print size, 200 DPI (a Letter page becomes 1700 x 2200 pixels)</span>
            </label>
          </div>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="pj-spec" class="mt-2">
            <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
          </dl>
          <p class="action-note">
            Before you run it: the words on each page become part of its picture. They can
            still be read by eye, but they cannot be selected, copied or searched as text
            afterwards.
          </p>
          <button id="pj-run" class="btn-primary w-full mt-5" type="button" disabled>Turn the pages into pictures</button>
          <p id="pj-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick a PDF to begin.</p>
        </div>
      </div>

      <div id="pj-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="pj-stamp">Done on your device</span>
        </div>
        <p id="pj-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="pj-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the pictures</a>
      </div>
    </section>

    <StepsStrip who="For a portal or a person who wants a page as a picture, a document that has to be posted where PDFs are not welcome, or pages that need to go into a photo tool." steps={[{ n: '01', t: 'Pick the PDF' }, { n: '02', t: 'Pick the picture kind and size' }, { n: '03', t: 'Turn the pages into pictures and download' }]} />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Each page is drawn onto a fresh sheet at the size you picked, the way a reader
          shows it, and saved as a picture: JPG at quality 92, or PNG exactly. Pages are
          drawn one at a time and packed as they finish, into the picture itself for a
          one-page file or one ZIP for a longer one, with the pictures named in page order.
          The download is how we protect your privacy: the program that does this job is
          part of this page, loaded from this site, and your file is read into the page and
          never uploaded.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The pictures are held in your device's memory until they are packed, so the limit
          on a long document is the device itself: in our tests a 50-page document rendered
          page by page at screen size without trouble, and print size makes each picture
          roughly four times the memory. A document of hundreds of pages at print size can
          outgrow a phone; if a run fails partway, nothing is sent anywhere, and screen
          size is the lighter road. Pages are drawn over white, the way they look on paper,
          so a page drawn with see-through parts does not come out see-through.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">A password-protected PDF cannot be opened by this tool. Take its password off first with the <a class="underline underline-offset-4" href="/unlock-pdf/">unlock tool</a>, then bring the file back.</p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/pdf-to-jpg.js';
  </script>
</Base>
