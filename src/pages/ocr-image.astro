---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'How well does it read?',
    a: 'Sharpness decides. The engine behind this page read 96.1% of characters on a clean test invoice at 300 DPI sharpness, and 99% on this page\'s own clean test picture. A straight, well-lit photo of printed text reads close to that; a tilted, shadowed or crumpled one reads worse, sometimes much worse.',
  },
  {
    q: 'Can I trust the numbers it reads?',
    a: 'Check them. On our clean test invoice this engine read the total 124.50 as 12450, dropping the decimal point. That is why the text is shown in an editable box: read it, fix anything, then copy or download. Never send on numbers you have not eyeballed.',
  },
  {
    q: 'Does it read handwriting?',
    a: 'No. This reader reads printed text only: letters, screenshots, signs, forms. A handwritten note will come back as fragments or nothing at all, and we would rather say so here than let the box fill with guesses.',
  },
  {
    q: 'What languages can it read?',
    a: 'English, Spanish and Portuguese. English is ready first; pick Spanish or Portuguese in the "Words are in" control and that reading data (about 2 MB) loads once, only when picked.',
  },
  {
    q: 'Where does my photo go?',
    a: 'Nowhere. Photos hold some of the most private paper people own, and this page was built for that: the file is read into this page and processed in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
// HowTo: the steps are this page's own workflow, transcribed from its
// intro, ticket labels and "How it works" text.
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to read the words in a photo (OCR)",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick a photo or screenshot", text: "Drop a photo or screenshot on the tray, or click to pick one (JPG, PNG or WebP). It stays on this device." },
    { '@type': 'HowToStep', position: 2, name: "Read the words", text: "Press 'Read the words'. Small pictures are enlarged before reading; the first run loads the reading program (about 10 MB, one time only)." },
    { '@type': 'HowToStep', position: 3, name: "Check the text", text: "The recognised text lands in an editable box below: it is yours to check and fix before anything is copied or downloaded." },
    { '@type': 'HowToStep', position: 4, name: "Copy or download", text: "Copy the text to your clipboard, or download it as a .txt. Both use the text exactly as it stands in the box, your fixes included." },
  ],
});
---

<Base title="OCR image to text: read the words in a photo, free, in your browser · Benchzy" description="Read the words out of a photo or screenshot: text you can check, fix, copy and download as a .txt. English, Spanish and Portuguese. The reading runs inside your browser. No upload, no account.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Image tools</p>
      <h1 class="font-display text-4xl font-black mt-2">Read the words in a photo (OCR)</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        A photo of a page is a locked box: you can look at the words, but you cannot search them,
        copy them or paste them anywhere. This page reads the words out of the picture, shows you
        the text to check, and hands it back as text you can copy or download. Everything runs in
        your browser; the photo is never uploaded. If your words are in a scanned PDF instead, the
        <a class="underline underline-offset-4" href="/ocr-pdf/">scan reader</a> does the same job
        on PDF pages and builds a searchable PDF.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="oi-tool">
      <div id="oi-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick an image">
        <p class="font-display text-xl font-bold">Drop a photo or screenshot on the tray, or click to pick one</p>
        <p class="font-mono text-xs text-ink-soft mt-2">JPG, PNG or WebP · it stays on this device</p>
        <p class="font-mono text-xs text-ink-soft mt-1">JPG, PNG, WebP and iPhone HEIC photos work here.</p>
        <input id="oi-file" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.heic,.heif" class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="oi-file" role="status"></p>
      <p class="action-note">
        The warning belongs here, before you pick: check every number in the result against the
        original. This reader has been caught dropping the decimal point in money amounts
        (124.50 read as 12450) on a clean test page, so a figure that looks read may still be wrong.
      </p>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">How the reading goes</h2>
          <p class="text-ink-soft text-sm leading-relaxed mt-3 max-w-md">
            The picture is read here in the page, and the words land in an editable box below:
            check them, fix them, then copy them or download them as a .txt. Pictures under
            750 px on the long side are enlarged before reading; the spec on the right says
            which plan your picture gets before anything runs.
          </p>
        </div>
        <div>
          <label class="font-mono text-xs uppercase tracking-widest text-ink-soft block" for="oi-lang">Words are in</label>
          <select id="oi-lang" class="border border-ink bg-ticket px-3 py-2 font-mono mt-2 w-full">
            <option value="eng" selected>English</option>
            <option value="spa">Español (Spanish)</option>
            <option value="por">Português (Portuguese)</option>
          </select>
          <p class="text-ink-soft text-sm mt-2">The Spanish and Portuguese reading data (about 2 MB each) loads once, only if you pick them.</p>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft mt-5">File spec</h2>
          <dl id="oi-spec" class="mt-2">
            <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
          </dl>
          <button id="oi-run" class="btn-primary w-full mt-5" type="button" disabled>Read the words</button>
          <p id="oi-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick a photo or screenshot to begin.</p>
        </div>
      </div>

      <div id="oi-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="oi-stamp">Done on your device</span>
        </div>
        <p id="oi-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <label class="font-mono text-xs uppercase tracking-widest text-ink-soft block mt-5" for="oi-text">The text, for checking</label>
        <textarea id="oi-text" rows="12" class="mt-2 w-full border border-ink bg-ticket px-3 py-2 font-mono text-sm leading-relaxed"></textarea>
        <div class="flex gap-3 mt-4 flex-wrap">
          <button id="oi-copy" class="btn-primary" type="button">Copy the text</button>
          <button id="oi-download-txt" class="btn-primary" type="button">Download the text (.txt)</button>
        </div>
      </div>
    </section>

    <StepsStrip who="For words trapped in a picture: a photo of a letter or a notice, a screenshot of a message or an error, a snap of a form." steps={[{ n: '01', t: 'Pick a photo or screenshot' }, { n: '02', t: 'Read the words' }, { n: '03', t: 'Check, copy, download' }]} />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The sharpness matters more than anything. In the tests behind this engine, the same
          page read at 200 DPI fell apart (about 62% of characters right), while at 300 DPI it
          read 96.1%. A photo is already a picture, so this page reads it as it comes, with one
          exception: a small picture is enlarged first, because small text is where the reader
          starves. On this page's clean test picture, a full invoice, it read 99% of the
          characters right.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The first run loads the reading program (about 10 MB, once). The download is how we
          protect your privacy: the program comes to your device and does the work there, so
          your photo never leaves it. Other sites do it the other way round: you send them
          your photo.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Printed text only. This reader does not read handwriting: a handwritten note will
          come back as fragments or nothing at all, and we do not promise otherwise. Clean,
          straight, well-lit pictures read well; tilted phone photos, shadows, glare and
          crumpled paper read worse, sometimes much worse.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Numbers are the weak spot: this engine dropped a decimal point in a money amount on
          a clean test page, so check every figure with a decimal point against the original,
          character by character.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Small pictures (under 750 px on the long side) are enlarged 3x before reading,
          because on a rough, small test picture that took the reading from 94% to 99% of
          characters right; a bigger, sharper original still beats any enlargement. Very large
          pictures are shrunk to at most 6,000 px on the long side before reading.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script is:inline src="/tesseract/tesseract.min.js"></script>
  <script>
    import '../scripts/ocr-image.js';
  </script>
</Base>
