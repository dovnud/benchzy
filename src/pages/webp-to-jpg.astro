---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';
import ConvertDoor from '../components/ConvertDoor.astro';

const faq = [
  {
    q: 'Why can some programs not open my WebP?',
    a: 'WebP is a younger format than JPG. Browsers read it happily, which is why websites serve it, but older editors, some print queues, office programs and a few portals still refuse it. JPG is the format everything opens, which is the whole point of this door.',
  },
  {
    q: 'What happens to the transparent parts?',
    a: 'WebP can hold see-through pixels; JPG cannot. Any transparent part of your WebP is painted over a colour you pick at the tray (white unless you change it), and the result line says when this happened. If the transparency matters, the WebP to PNG door keeps it.',
  },
  {
    q: 'Will the JPG be bigger than the WebP?',
    a: 'Usually, yes: WebP is the more efficient format, so the same picture at a similar quality tends to weigh more as a JPG. The result line prints both sizes, so the trade for compatibility is never silent.',
  },
  {
    q: 'Where does my file go?',
    a: 'Nowhere. It is decoded, re-encoded and offered back to you inside this page. Nothing is uploaded.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to convert a WebP to a JPG",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick a WebP", text: "Drop a WebP on the tray, or click to pick one. It stays on this device. A file in the wrong format is pointed at the right door." },
    { '@type': 'HowToStep', position: 2, name: "Set the conversion", text: "Pick the quality, and if your WebP has see-through parts, the colour they are painted over: JPG cannot hold transparency, and the colour is white unless you change it." },
    { '@type': 'HowToStep', position: 3, name: "Convert to JPG", text: "Press 'Convert to JPG'. The WebP is decoded and written as a JPG here in the page; the result line prints the bytes before and after." },
    { '@type': 'HowToStep', position: 4, name: "Download the JPG", text: "Download the JPG at the dimensions and size the result line states." },
  ],
});
---

<Base title="WebP to JPG: convert a WebP to a JPG, free, in your browser · Benchzy" description="Convert one WebP to a JPG inside your browser, for the editors, portals and print queues that refuse WebP. Transparent parts are painted over a colour you pick, stated before the run. No upload, no account.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Image tools · convert</p>
      <h1 class="font-display text-4xl font-black mt-2">WebP to JPG</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Websites hand out WebP pictures because they are small; half the rest of the world
        still cannot open them. This door converts one WebP to a JPG, the format everything
        opens, here in your browser. The one real change is stated before you run: WebP can
        be see-through and JPG cannot, so transparent parts are painted over a colour you
        pick (white unless you change it). A whole folder at once is the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/batch-convert-images/">batch convert page</a>;
        the reverse trip is <a class="underline underline-offset-4 hover:text-accent-deep" href="/jpg-to-webp/">JPG to WebP</a>.
      </p>
    </section>

    <StepsStrip who="For one WebP that has to open somewhere WebP cannot go: an older editor, a print queue, a portal, a document." steps={[{ n: '01', t: 'Pick a WebP' }, { n: '02', t: 'Set quality and the background colour' }, { n: '03', t: 'Download the JPG' }]} />

    <ConvertDoor from="webp" to="jpeg" note="The reach changes, and the dimensions do not. The picture is re-encoded as a JPG that older programs and portals can open. If your WebP has see-through parts, they are painted over the colour below, because JPG cannot hold transparency; the result line says when that happened." />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The WebP is decoded by the open-source jSquash codecs, any transparency is painted
          over your colour, and the picture is written as a JPG at your quality, the same
          engine the batch convert page runs. The first run loads the image program (about
          2 MB, one time only). The download is how we protect your privacy: the program
          comes to your device and does the work there, so your file never leaves it.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          You are trading efficiency for reach: the JPG will usually be the bigger file, and
          the conversion is a fresh lossy write, so keep the WebP if it is your master copy.
          Animated WebP is read as its first frame only; this door is for still pictures.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/convert-image.js';
  </script>
</Base>
