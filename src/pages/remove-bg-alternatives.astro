---
import Base from '../layouts/Base.astro';

// Every wall below is stated the way we found it: remove.bg and Benchzy
// from our own dated tests and dossier (November 2026); the rest as
// reported in the shutdown coverage we read on 7 November 2026, with the
// source named on the entry. This page is kept as a list with dates, not
// a ranking we pretend is science.
const alts = [
  {
    name: 'Benchzy (this site)',
    wall: 'No wall. Full size free, no account, no credits, no counter, output fine for business use. Your photo is processed in your browser and never uploaded.',
    cost: 'Free. The first run downloads the removal program (44.3 MB) once.',
    src: 'Our own tool and tests, November 2026.',
    href: '/remove-background/',
  },
  {
    name: 'Canva',
    wall: 'The official destination: remove.bg itself sends its users here. Background removal inside Canva is a paid-plan feature, and the job becomes one feature inside a large design suite.',
    cost: 'Paid Canva plan for the background remover.',
    src: 'The makers\' own announcement and plan pages, read November 2026; not a hands-on test by us.',
    href: null,
  },
  {
    name: 'Pixlr',
    wall: '3 free saves a day, as reported in shutdown coverage.',
    cost: 'Free tier rationed by saves; paid plans beyond it.',
    src: 'Third-party report, not our own test: Playyy shutdown round-up, read 7 November 2026.',
    href: null,
  },
  {
    name: 'Photoroom',
    wall: 'Export allowances are plan-based: what you can download at full quality depends on the plan you hold.',
    cost: 'Free tier limited; paid plans for full export allowances.',
    src: 'Third-party report, not our own test: shutdown coverage read 7 November 2026.',
    href: null,
  },
  {
    name: 'Removal.ai',
    wall: 'The same shape as remove.bg: free downloads capped at 0.25 megapixels, full size paid.',
    cost: 'Free small downloads; paid full size.',
    src: 'Third-party report, not our own test: shutdown coverage read 7 November 2026.',
    href: null,
  },
  {
    name: 'Pixelcut',
    wall: 'Its free-use count is not published, so the wall is found by hitting it.',
    cost: 'Free use, amount unpublished.',
    src: 'Third-party report, not our own test: shutdown coverage read 7 November 2026.',
    href: null,
  },
];
---

<Base title="remove.bg alternatives, with the walls marked · Benchzy" description="The honest alternatives list for after 1 December 2026: Canva, Pixlr, Photoroom, Removal.ai, Pixelcut and Benchzy, each with its free wall stated and dated.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Guide · checked 8 November 2026</p>
      <h1 class="font-display text-4xl font-black mt-2">remove.bg alternatives</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        remove.bg closes its standalone site on 1 December 2026, so its users need a new home
        for the job. Every well-known alternative keeps some kind of wall; this list names each
        one plainly, from its own terms or from the dated shutdown coverage. Entries we have
        not tested ourselves say so on the entry, as third-party reports, so the choice is
        made with open eyes. Ours is on the list too, with its real cost stated: a 44.3 MB
        first-run download, and 9.7 to 10.6 seconds a photo in warm runs on a desktop-class
        machine once the program is downloaded, the first photo of a session slower.
      </p>
    </section>

    <section class="mt-6 grid gap-4">
      {alts.map((a) => (
        <article class="ticket-soft p-5">
          <h2 class="font-display text-xl font-bold">{a.name}</h2>
          <dl class="mt-2">
            <div class="spec-row"><dt>the wall</dt><dd class="max-w-xl">{a.wall}</dd></div>
            <div class="spec-row"><dt>cost</dt><dd>{a.cost}</dd></div>
            <div class="spec-row"><dt>source</dt><dd>{a.src}</dd></div>
          </dl>
          {a.href && <a class="btn-primary no-underline mt-3 inline-block" href={a.href}>Open the tool</a>}
        </article>
      ))}
    </section>

    <section class="mt-10 mb-4 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How to choose</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Ask three questions of any entry, including ours. What size is the free download,
          really? What happens on the tenth photo, and the hundredth? And where does your photo
          go while it is processed? The answers separate the list faster than any feature table.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Dates and corrections</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Walls and prices change. This page carries its check date (8 November 2026) and names
          its sources per entry, so a stale line can be spotted and fixed. The full dated story
          of the shutdown is on the
          <a class="underline underline-offset-4" href="/remove-bg-december-1/">1 December explainer</a>.
        </p>
      </div>
    </section>
  </div>
</Base>
