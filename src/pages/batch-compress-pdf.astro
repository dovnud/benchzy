---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'Why is batch the thing other sites charge for?',
    a: 'Because on a server, every extra file costs the site money, so the big suites sell running-many-files-at-once as a paid extra, or cap a free job at one or two files. Here the work runs on your device, so a folder costs this site nothing. Batch is the ordinary way this page works, not an upgrade.',
  },
  {
    q: 'One target for every file?',
    a: 'Yes. Pick the target once (200 KB, 500 KB, 2 MB or your own number) and every PDF on the tray is worked to it, with the same probe-first engine as the Compress PDF page. Each file gets its own result line: the size it reached, or the honest reason it stayed unchanged.',
  },
  {
    q: 'What if one file fails?',
    a: 'It is listed as failed or skipped, with the reason in plain words, and the rest of the batch carries on. The ZIP holds every file that was processed, including originals that could not shrink, each under its own name.',
  },
  {
    q: 'Where do my PDFs go?',
    a: 'Nowhere. They are read into this page and processed in your browser, one at a time so the memory stays sane. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to compress many PDFs at once",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick your PDFs", text: "Drop PDFs on the tray, or click to pick them. The batch was tested with 50 files in one run; they are read into this page and never uploaded." },
    { '@type': 'HowToStep', position: 2, name: "Set one target", text: "Pick the target size once: 200 KB, 500 KB, 2 MB or your own number. The same target is applied to every file." },
    { '@type': 'HowToStep', position: 3, name: "Run the batch", text: "Press 'Compress the batch'. Each PDF is shrunk by recompressing the photos inside it, one file at a time, and gets its own result line." },
    { '@type': 'HowToStep', position: 4, name: "Download the results", text: "Download files one by one, or take the whole batch away as a single ZIP." },
  ],
});
---

<Base title="Batch compress PDF: shrink many PDFs at once, free · Benchzy" description="Compress a whole folder of PDFs to one target size in a single run, inside your browser. Per-file results, one ZIP download. No upload, no account, no file-count cap.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">PDF tools · batch</p>
      <h1 class="font-display text-4xl font-black mt-2">Batch compress PDF</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Forty scans, one portal limit. Drop the whole folder on the tray, set one target, and
        every PDF is worked to it in a single run, each with its own result line. On the big
        suites this job is a paid extra; here it is simply free. One file at a time is on the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/compress-pdf/">Compress PDF page</a>.
      </p>
    </section>

    <StepsStrip who="For a folder of scans, statements, or application documents that all have to fit under one portal limit." steps={[{ n: '01', t: 'Pick your PDFs' }, { n: '02', t: 'Set one target' }, { n: '03', t: 'Run and download the results' }]} />

    <section class="ticket mt-6 p-5 sm:p-7" id="bp-tool" data-mode="compress">
      <div id="bp-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick PDFs">
        <p class="font-display text-xl font-bold">Drop PDFs on the tray, or click to pick them</p>
        <p class="font-mono text-xs text-ink-soft mt-2">PDF · tested with 50 files in one run · they stay on this device</p>
        <input id="bp-file" type="file" accept="application/pdf,.pdf" multiple class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="bp-file" role="status"></p>

      <ul id="bp-list" class="mt-6"></ul>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">One target for the batch</h2>
          <div id="bp-targets" class="flex gap-2 mt-3 flex-wrap">
            <button class="chip" type="button" data-kb="200">200 KB</button>
            <button class="chip" type="button" data-kb="500" aria-pressed="true">500 KB</button>
            <button class="chip" type="button" data-kb="2000">2 MB</button>
          </div>
          <div class="flex items-center gap-2 mt-3">
            <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="bp-custom">Or your own (KB)</label>
            <input id="bp-custom" type="number" min="20" max="50000" step="10" value="500" class="border border-ink bg-ticket px-3 py-2 font-mono w-28" />
          </div>
          <p class="text-ink-soft text-sm leading-relaxed mt-3 max-w-md">
            Files are processed one at a time, so a big batch does not need a big device. A file
            that cannot shrink is kept as its original and the result line says why.
          </p>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="bp-spec" class="mt-2">
            <div class="spec-row"><dt>files on the tray</dt><dd>0</dd></div>
          </dl>
          <button id="bp-run" class="btn-primary w-full mt-5" type="button" disabled>Compress the batch</button>
          <p id="bp-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick PDFs to begin.</p>
        </div>
      </div>

      <div id="bp-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Results</h2>
          <span class="stamp" id="bp-stamp">Done on your device</span>
        </div>
        <div id="bp-rows" class="mt-4 grid gap-1"></div>
        <a id="bp-zip" class="btn-primary inline-block no-underline mt-4 hidden" href="#" download>Download all as one ZIP</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Each file runs the Compress PDF engine in turn: the photos inside are read once, a
          probe picks the starting setting, and the ladder steps down only as far as it must.
          Results collect on this page with the exact sizes, and the ZIP packs every processed
          file under its own name. Nothing is uploaded at any point.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The limit is your device, not us: the batch was tested with 50 files in one run, and
          past that your device's memory is the limit. A very long batch takes as long as it takes, one
          file at a time, and the page stays honest about progress. A PDF whose bulk is not
          photos may not shrink at all; it is returned as its original and the result line says
          so, in the same size type as the successes.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">A password-protected PDF cannot be opened by this tool. Take its password off first with the <a class="underline underline-offset-4" href="/unlock-pdf/">unlock tool</a>, then bring the file back.</p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/batch-pdf.js';
  </script>
</Base>
