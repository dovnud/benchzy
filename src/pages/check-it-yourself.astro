---
import Base from '../layouts/Base.astro';
import LangLinks from '../components/LangLinks.astro';

// Language cluster (milestone 8): this page in Spanish and Brazilian
// Portuguese, full translations, wired both ways.
const alternates = [
  { hreflang: 'en', href: '/check-it-yourself/' },
  { hreflang: 'es', href: '/es/compruebalo-tu-mismo/' },
  { hreflang: 'pt-BR', href: '/pt-br/confira-voce-mesmo/' },
  { hreflang: 'x-default', href: '/check-it-yourself/' },
];
const langLinks = [
  { label: 'English', href: '/check-it-yourself/', current: true },
  { label: 'Español', href: '/es/compruebalo-tu-mismo/' },
  { label: 'Português (Brasil)', href: '/pt-br/confira-voce-mesmo/' },
];

const families = [
  ['PDF tools', 'The @cantoo/pdf-lib program and, for scans, PDF.js plus Tesseract.js, all loaded from this site.', 'Nothing. The PDF is read into the page and the result is built there.'],
  ['Image tools', 'The jSquash codec programs (WebAssembly), loaded from this site.', 'Nothing. The photo is decoded, worked on and re-encoded in the page.'],
  ['Background removal', 'The removal program, 44.3 MB, arriving as 11 pieces your browser checks against a printed fingerprint list before running it.', 'Nothing. The photo stays in the page; only the program travels, and it travels to you, not from you.'],
  ['Any page on this site', 'The page itself and its program files, like any website. Two more things load, both from Google, both as the page opens: the visit counter, a small program from Google (Google Analytics), which fires once when the page opens, and the ad loader (Google AdSense), the program that serves this site\'s ads, named on the privacy page.', 'Of your file, nothing. The counter and the ad loader arrive when a page opens, before any tool runs, and a tool run sends them nothing and calls nothing new. What they carry is the visit itself: which page opened, roughly where the connection comes from, and the kind of device and browser. In the lists above, their lines are the ones addressed to Google and labelled "visit counter" and "ad loader", so you can tell them apart from this site\'s own lines. Routine request logs also exist, as on any site. The full detail is on the privacy page.'],
];
const steps = [
  'Open any tool page on this site.',
  'Open your browser\'s developer tools and pick the Network panel. In Chrome it is under the menu "More tools, Developer tools"; in Firefox and Safari it is in the developer or Web Inspector menu.',
  'Press the clear button on the network list, then run a job with a real file.',
  'Watch the list while the job runs and at the moment you download. The lines are this page asking its own site for program files, plus the visit counter\'s and the ad loader\'s lines from when the page opened (addressed to Google, and they carry the visit, never a file). Nothing in the list carries your file, because no request is made with it.',
];
---

<Base title="Check it yourself: watch what a job sends · Benchzy" description="Do not take our word for it. Run a job while this page lists every request it makes, live, or use your own browser network panel with these steps." alternates={alternates}>
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Trust nothing, watch it</p>
      <h1 class="font-display text-4xl font-black mt-2">Check it yourself</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Every tool here says your file is never uploaded. That sentence is only worth something
        if you can watch it being true. This page runs a real job while listing, live, every
        request it makes. And because a page grading its own homework is worth little, the
        manual steps below it show the same check with your own browser's tools, on any page
        of this site.
      </p>
      <LangLinks label="This page in:" links={langLinks} />
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="witness">
      <h2 class="font-display text-2xl font-bold">The live witness</h2>
      <p class="mt-2 text-ink-soft leading-relaxed max-w-2xl">
        Since this page opened, it has been keeping two lists: what it loaded when it arrived,
        and every request it has made since. Run the job below and watch the second list while
        it works.
      </p>
      <p id="w-verdict" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Witness arming…</p>

      <div id="w-tray" class="tray p-6 text-center cursor-pointer mt-5" role="button" tabindex="0" aria-label="Pick a file for the witnessed job">
        <p class="font-display text-xl font-bold">Drop any file here for the witnessed job</p>
        <p class="font-mono text-xs text-ink-soft mt-2">the job reads it, fingerprints it and describes it, in this page only</p>
        <input id="w-file" type="file" class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="w-file" role="status"></p>
      <dl id="w-spec" class="mt-4">
        <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
      </dl>
      <p id="w-job-status" class="font-mono text-sm mt-3 leading-relaxed" aria-live="polite">No job yet.</p>

      <div class="grid gap-6 md:grid-cols-2 mt-6">
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Loaded when this page opened</h3>
          <p id="w-before-count" class="font-mono text-xs text-ink-soft mt-1"></p>
          <ul id="w-before" class="font-mono text-xs leading-relaxed mt-2 max-h-56 overflow-auto"></ul>
        </div>
        <div>
          <h3 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Requests since, live</h3>
          <ul id="w-live" class="font-mono text-xs leading-relaxed mt-2 max-h-56 overflow-auto"></ul>
        </div>
      </div>
      <p class="font-mono text-xs text-ink-soft mt-4 leading-relaxed">
        What this proves, exactly: the job above ran with the requests shown, and none of them
        carried your file. What it does not prove by itself: that other pages behave the same.
        That is what your own network panel, below, is for.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">The same check, with your own tools</h2>
      <ol class="mt-4 grid gap-4">
        {steps.map((s, i) => (
          <li class="ticket-soft p-4 font-mono text-sm leading-relaxed">
            <span class="text-accent-deep font-bold">{String(i + 1).padStart(2, '0')} ·</span> {s}
          </li>
        ))}
      </ol>

      <h3 class="font-display text-xl font-bold mt-8">What a bad line would look like</h3>
      <p class="mt-2 text-ink-soft leading-relaxed max-w-2xl">
        In a healthy run, every line in the list asks this site for a program file and carries
        nothing of yours — apart from the visit counter's and the ad loader's lines from when
        the page opened, which carry the visit itself and nothing of your file. A line that
        should stop you looks like this:
      </p>
      <p class="ticket-soft p-4 font-mono text-sm leading-relaxed mt-3">
        POST https://uploads.some-other-site.example/receive · to another site · WITH DATA
        ATTACHED: the request body carries bytes out instead of asking for a file in.
      </p>
      <p class="mt-3 text-ink-soft leading-relaxed max-w-2xl">
        Two tells: the address is not this site, and the request sends data instead of asking
        for a file. If a line like that ever appears while a Benchzy job runs, the promise on
        this page is broken, and the network panel is how you would catch it.
      </p>

      <h3 class="font-display text-xl font-bold mt-8">The airplane-mode check</h3>
      <ol class="mt-4 grid gap-4">
        <li class="ticket-soft p-4 font-mono text-sm leading-relaxed"><span class="text-accent-deep font-bold">01 ·</span> Open the tool page once, while connected, and let it load fully. The tool's program comes from this site on that first visit.</li>
        <li class="ticket-soft p-4 font-mono text-sm leading-relaxed"><span class="text-accent-deep font-bold">02 ·</span> Turn airplane mode on, or switch Wi-Fi and mobile data off.</li>
        <li class="ticket-soft p-4 font-mono text-sm leading-relaxed"><span class="text-accent-deep font-bold">03 ·</span> Run the job end to end and download the result. It works offline, because the work happens in the page, on your device.</li>
        <li class="ticket-soft p-4 font-mono text-sm leading-relaxed"><span class="text-accent-deep font-bold">04 ·</span> One limit, stated plainly: a tool page you have never opened still needs one connected first visit. With no connection and no earlier visit, there is no page and no program to run.</li>
      </ol>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">What leaves your device, family by family</h2>
      <div class="mt-4 grid gap-4">
        {families.map(([fam, loads, leaves]) => (
          <article class="ticket-soft p-5">
            <h3 class="font-display text-xl font-bold">{fam}</h3>
            <dl class="mt-2">
              <div class="spec-row"><dt>what loads</dt><dd class="max-w-xl">{loads}</dd></div>
              <div class="spec-row"><dt>of your file, what leaves</dt><dd class="max-w-xl">{leaves}</dd></div>
            </dl>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script>
    import '../scripts/witness.js';
  </script>
</Base>
