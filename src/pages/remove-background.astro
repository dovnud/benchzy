---
import Base from '../layouts/Base.astro';
import BgTicket from '../components/BgTicket.astro';
import StepsStrip from '../components/StepsStrip.astro';
import LangLinks from '../components/LangLinks.astro';

const alternates = [
  { hreflang: 'en', href: '/remove-background/' },
  { hreflang: 'es', href: '/es/quitar-fondo-de-imagen-gratis/' },
  { hreflang: 'pt-BR', href: '/pt-br/remover-fundo-de-imagem-gratis/' },
  { hreflang: 'x-default', href: '/remove-background/' },
];
const langLinks = [
  { label: 'English', href: '/remove-background/', current: true },
  { label: 'Español', href: '/es/quitar-fondo-de-imagen-gratis/' },
  { label: 'Português (Brasil)', href: '/pt-br/remover-fundo-de-imagem-gratis/' },
];

const faq = [
  {
    q: 'Is the result full size?',
    a: 'Yes. The cutout is produced at the same pixel dimensions as the photo you picked. Nothing is shrunk to a preview size.',
  },
  {
    q: 'Where does my photo go?',
    a: 'Nowhere. The photo is read into this page and processed by a program running in your browser. You can watch your browser network panel during the job: the only download is the removal program itself, once.',
  },
  {
    q: 'Why is the first run slower?',
    a: 'The first time, your browser downloads the removal program (44.3 MB). After that it is saved on your device and later visits start at once. The cut itself took 9.7 to 10.6 seconds per photo in warm runs on our desktop-class test computer, once the program is downloaded; the first photo of a session runs slower. Phones vary and we do not promise a phone time we have not measured.',
  },
  {
    q: 'What photos does it struggle with?',
    a: 'Hair, glass and see-through objects are good but not perfect; fine strands at the edge can be lost. If a photo has no clear subject, the tool says so instead of inventing a cutout.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
// HowTo (milestone 5): the steps are this page's own workflow, transcribed
// from its intro, ticket labels and "How it works" text above.
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to remove the background from a photo",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick a photo", text: "Drop a photo on the tray, or click to pick one. Your photo is read into this page and never uploaded." },
    { '@type': 'HowToStep', position: 2, name: "Remove the background", text: "Press 'Remove the background'. The first time, your browser downloads the removal program (44.3 MB, in 11 pieces it checks one by one); later visits reuse the saved copy." },
    { '@type': 'HowToStep', position: 3, name: "The subject is cut out", text: "The program reads the photo, works out which pixels belong to the subject, and writes a new picture where the rest is transparent." },
    { '@type': 'HowToStep', position: 4, name: "Compare and download", text: "Drag on the picture to compare before and after, then download the cutout (PNG) at full size." },
  ],
});
---

<Base title="Remove background from a photo, free, in your browser · Benchzy" description="Remove the background from a photo at full size, free, with the work done inside your browser. No upload, no account, no preview-size limit." alternates={alternates}>
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Background removal</p>
      <h1 class="font-display text-4xl font-black mt-2">Remove background</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Pick a photo and this page cuts out the subject at full size. The work runs in your browser:
        your photo is never uploaded. The 44.3 MB counts against mobile data on a phone, so the first run is better on Wi-Fi; on a slow connection the load can take a minute or more, and it can be cancelled while it runs: pieces already downloaded are kept, and the next run carries on from there. The download is how we protect your privacy. Our program
        comes to your device and does the work there, so your photo never leaves it. Other sites
        do it the other way round: you send them your photo. The first run downloads the removal program, 44.3 MB, once,
        as 11 pieces your browser checks one by one; that size is printed here before anything
        loads, and later visits reuse the saved copy. Before you trust it with a hard photo,
        you can look at what it did with six of ours:
        <a class="underline underline-offset-4" href="/remove-background/quality/">the quality proof page</a>
        shows white on white, fine hair, glass and chrome, run through this same tool, with
        100% edge crops and the cases where it visibly struggles.
      </p>
      <LangLinks label="This page in:" links={langLinks} />
    </section>

    <BgTicket locale="en" />

    <StepsStrip who="For a product photo, a profile picture, or a listing shot: the everyday job is a clean cutout you can drop onto any background." steps={[{ n: '01', t: 'Pick a photo' }, { n: '02', t: 'Remove the background' }, { n: '03', t: 'Compare and download' }]} />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          A background-removal program (an ISNet model, open weights, listed on the
          <a class="underline underline-offset-4" href="/credits/">credits page</a>) runs in this page
          through your browser's own machinery. It reads the photo, works out which pixels belong to
          the subject, and writes a new picture where the rest is transparent. Because the work happens
          here, a photo costs this site nothing to process, and your photo is never sent anywhere.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          This tool works in your browser, so its limits are your device's limits. Very large photos
          can run out of memory on small phones. Hair, glass and see-through edges are good but not
          perfect. The 44.3 MB first download is real, and it is printed on this page rather than
          sprung on you at the download button.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/remove-bg.js';
  </script>
</Base>
