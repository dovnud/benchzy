---
import Base from '../layouts/Base.astro';

const live = [
  { name: 'Compress image to exact KB', href: '/compress-image/', note: 'The tool the big sites do not offer: a photo at the exact size a form, portal or shop asks for. The page searches quality and size together until it lands within a whisker of your target, and prints every try. On the bench, a normal photo landed within 0.6% of 200, 100, 50 and 20 KB.' },
  { name: 'Compress image to 50 KB', href: '/compress-image-to-50kb/', note: 'The form and seller preset, with the 50 KB target already set.' },
  { name: 'Batch compress images', href: '/batch-compress-images/', note: 'The whole folder at one exact KB target, in one run: the same combined search per photo, a result line per file, one ZIP out. The metered converters count this job against you; this bench does not count anything.' },
  { name: 'Batch convert images', href: '/batch-convert-images/', note: 'A folder converted to JPG, PNG or WebP at one quality, with an optional maximum width. On the bench, our WebP of the test photo came out at 251,730 bytes against the biggest converter\'s 435,388 on the same file.' },
  { name: 'Batch remove background', href: '/batch-remove-background/', note: 'A folder of photos cut out at full size in one run. The model downloads once for the batch and is saved by your browser for the next one. Background removal\'s own workshop is next door.' },
  { name: 'Size checker', href: '/size-checker/', note: 'Before you shrink anything: exact bytes, real format, dimensions, and how the file lines up against the doors portals set (fits, or too big, and by how much).' },
];
const planned = [
  'Resize one image to an exact width (resizing a batch by maximum width works today on the batch convert bench)',
  'Strip hidden data (EXIF) with a before and after report (verified on the bench: injected place and camera data fully removed)',
];
---

<Base title="Image tools, free, in your browser · Benchzy" description="Shrink a photo to an exact KB, check its size and format, free, in your browser. No uploads, no accounts, no counters. Background removal has its own workshop next door.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Hub · image jobs</p>
      <h1 class="font-display text-4xl font-black mt-2">Image tools</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Photo jobs for forms, portals and shops, done inside your browser: the photo is never
        uploaded, and the size you asked for is the size you get, printed on the result. The
        codecs are the open-source jSquash set, named on the
        <a class="underline underline-offset-4" href="/credits/">credits page</a>.
        Background removal is a big enough job to have
        <a class="underline underline-offset-4" href="/background-removal/">its own workshop</a>,
        and that workshop also speaks
        <a class="underline underline-offset-4" href="/es/quitar-fondo-de-imagen-gratis/">español</a> and
        <a class="underline underline-offset-4" href="/pt-br/remover-fundo-de-imagem-gratis/">português</a>.
      </p>
    </section>

    <section class="mt-6 grid gap-4">
      {live.map((t) => (
        <article class="ticket-soft p-5 flex flex-wrap items-baseline gap-3">
          <h2 class="font-display text-xl font-bold">{t.name}</h2>
          <span class="stamp">On the bench</span>
          <p class="w-full text-ink-soft leading-relaxed">{t.note}</p>
          <a class="btn-primary no-underline mt-1" href={t.href}>Open the tool</a>
        </article>
      ))}
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">In the plan for this family</h2>
      <ul class="mt-4 grid gap-3">
        {planned.map((p) => (
          <li class="ticket-soft p-4 font-mono text-sm leading-relaxed">{p} <span class="text-ink-soft">(measured; opens when it passes its checks)</span></li>
        ))}
      </ul>
      <p class="mt-4 leading-relaxed text-ink-soft max-w-2xl">
        One honest note from the bench: AVIF gives the smallest files we measured, but took
        about 50 seconds a photo to make. If it ships here, it will be labelled the slow option
        in the same size type as everything else, per the
        <a class="underline underline-offset-4" href="/what-free-means/">standing rules</a>.
      </p>
    </section>
  </div>
</Base>
