---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'How exact is the result?',
    a: 'On a normal photo, this search landed within about half a percent of the target at 200, 100, 50 and 20 KB. The page searches quality and, when quality alone has no setting close enough (which happens on very noisy photos), the dimensions too, and it shows you the exact final size and how far it sits from your target.',
  },
  {
    q: 'Why a separate page for JPG?',
    a: 'Because the job usually starts with a JPG and a size limit: a form, a listing or a portal that says "JPG, under 200 KB". This door takes a JPG in and hands a JPG back at your target, with nothing else to set. Other picture kinds, and targets for them, are on the compress image page.',
  },
  {
    q: 'My photo is a PNG. What happens here?',
    a: 'This door says so at the tray: it starts from a JPG. A PNG goes to the compress image page, which takes it as it is, or to the compress PNG door.',
  },
  {
    q: 'Where does my photo go?',
    a: 'Nowhere. It is decoded, re-encoded and offered back to you inside this page. Nothing is uploaded.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to compress a JPG to an exact KB",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick the JPG photo", text: "Drop a JPG photo on the tray, or click to pick one. It stays on this device. Another picture kind is pointed at the compress image page." },
    { '@type': 'HowToStep', position: 2, name: "Pick the target", text: "Choose a preset target or type your own target in KB." },
    { '@type': 'HowToStep', position: 3, name: "Compress to the target", text: "Press 'Compress to the target'. The page decodes your photo and runs a search: it encodes at different quality settings, watches the sizes, and closes in on your target; on hard photos it adjusts the dimensions too." },
    { '@type': 'HowToStep', position: 4, name: "Download the JPG", text: "The achieved size and its distance from your target are shown on the result." },
  ],
});
const targets = [200, 100, 50];
---

<Base title="Compress JPG to an exact KB, free, in your browser · Benchzy" description="Shrink a JPG photo to 200 KB, 100 KB, 50 KB or an exact size you pick, with the work done inside your browser. No upload, no account. The achieved size and its distance from the target are shown.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Image tools · JPG</p>
      <h1 class="font-display text-4xl font-black mt-2">Compress JPG</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        A JPG photo, and a door that wants it smaller: under 200 KB, under 100 KB. This page
        takes the target itself and searches quality and size until the JPG lands there, in
        your browser, with nothing uploaded. It is the JPG door of the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/compress-image/">compress image tool</a>,
        which also takes PNG, WebP and HEIC photos. A whole folder at one target is the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/batch-compress-images/">batch compress images page</a>.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="ci-tool" data-lock-format="jpeg">
      <div id="ci-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick a JPG photo">
        <p class="font-display text-xl font-bold">Drop a JPG photo on the tray, or click to pick one</p>
        <p class="font-mono text-xs text-ink-soft mt-2">JPG in · JPG out · it stays on this device</p>
        <input id="ci-file" type="file" accept="image/jpeg,.jpg,.jpeg" class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="ci-file" role="status"></p>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Target size</h2>
          <div id="ci-targets" class="flex gap-2 mt-3 flex-wrap">
            {targets.map((kb) => (
              <button type="button" class="chip" data-kb={kb} aria-pressed="false">{kb} KB</button>
            ))}
          </div>
          <label class="font-mono text-xs uppercase tracking-widest text-ink-soft block mt-5" for="ci-custom">Or your own target (KB)</label>
          <input id="ci-custom" type="number" min="5" max="20000" step="5" class="mt-2 border border-ink bg-ticket px-3 py-2 font-mono w-40" />
          <img id="ci-preview" alt="The compressed result" class="hidden w-full border border-line bg-paper-deep object-contain max-h-72 mt-6" />
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="ci-spec" class="mt-2">
            <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
          </dl>
          <button id="ci-run" class="btn-primary w-full mt-5" type="button" disabled>Compress to the target</button>
          <p id="ci-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick a JPG photo to begin.</p>
        </div>
      </div>

      <div id="ci-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="ci-stamp">Done on your device</span>
        </div>
        <p id="ci-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="ci-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the photo (JPG)</a>
      </div>
    </section>

    <StepsStrip who="For a JPG photo that must fit an exact KB limit on a form, a listing, or a marketplace upload." steps={[{ n: '01', t: 'Pick the JPG photo' }, { n: '02', t: 'Pick the target' }, { n: '03', t: 'Download the JPG' }]} />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The page decodes your JPG and runs a search: it encodes at different quality
          settings, watches the sizes, and closes in on your target. On hard photos, quality
          alone has no setting that lands close (the steps jump over the window), so the
          search then adjusts the dimensions too. That combined search is the shipping
          method here; on the hardest test photo we have, it landed within about a third of
          a percent of the target.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Very small targets mean a softer or smaller photo; the result line always states
          the quality and dimensions used, so you can judge the trade yourself. If a JPG is
          already under your target, you get it back unchanged. This door takes JPG only:
          that is its framing, and the tray says so when another kind of picture arrives.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/compress-image.js';
  </script>
</Base>
