---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'What can I convert between?',
    a: 'Any mix of JPEG, PNG and WebP goes in; everything comes out in the one format you pick: JPG, PNG or WebP. PNG output is lossless and ignores the quality setting; JPG and WebP use it. An optional maximum width shrinks big photos as they convert.',
  },
  {
    q: 'How good is the WebP?',
    a: 'Measured in our tests: the test photo as WebP at quality 80 came out at 251,730 bytes, against 435,388 bytes from the biggest converter on the same photo. That is the setting this page starts on.',
  },
  {
    q: 'Is there a per-day allowance?',
    a: 'No. The metered converters ration this job by minutes and operations; this page has no counter to hit, because the work runs on your device and costs this site nothing per photo.',
  },
  {
    q: 'Where do my photos go?',
    a: 'Nowhere. They are read into this page and converted in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to convert many images to one format",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick your images", text: "Drop images on the tray, or click to pick them. JPEG, PNG and WebP all read in. They are never uploaded." },
    { '@type': 'HowToStep', position: 2, name: "Pick the output format", text: "Choose JPG, PNG or WebP, set the quality for JPG and WebP, and optionally a maximum width." },
    { '@type': 'HowToStep', position: 3, name: "Run the batch", text: "Press 'Convert the batch'. Each photo is decoded and re-encoded in the chosen format, one at a time, with its own result line." },
    { '@type': 'HowToStep', position: 4, name: "Download the results", text: "Download photos one by one, or take the whole batch away as a single ZIP." },
  ],
});
---

<Base title="Batch convert images: JPG, PNG and WebP in bulk, free · Benchzy" description="Convert a folder of photos to JPG, PNG or WebP in one run, inside your browser, with an optional maximum width. No upload, no account, no conversion minutes.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Image tools · batch</p>
      <h1 class="font-display text-4xl font-black mt-2">Batch convert images</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        A folder of mixed photos, one format out. Pick JPG, PNG or WebP, set the quality, and
        every photo is converted in a single run, with an optional maximum width for shops and
        listings that cap dimensions. If instead you need one exact file size, the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/batch-compress-images/">batch compress page</a> is next door.
        Converting just one photo, with the direction picked for you:
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/png-to-jpg/">PNG to JPG</a> ·
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/jpg-to-png/">JPG to PNG</a> ·
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/webp-to-jpg/">WebP to JPG</a> ·
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/jpg-to-webp/">JPG to WebP</a> ·
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/png-to-webp/">PNG to WebP</a> ·
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/webp-to-png/">WebP to PNG</a>.
      </p>
    </section>

    <StepsStrip who="For a folder in the wrong format: a shoot to JPG, screenshots to PNG, a set to WebP for a website." steps={[{ n: '01', t: 'Pick your images' }, { n: '02', t: 'Pick the output format' }, { n: '03', t: 'Run and download the results' }]} />

    <section class="ticket mt-6 p-5 sm:p-7" id="bi-tool" data-mode="convert">
      <div id="bi-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick images">
        <p class="font-display text-xl font-bold">Drop images on the tray, or click to pick them</p>
        <p class="font-mono text-xs text-ink-soft mt-2">JPEG · PNG · WebP · tested with 100 files in one run · they stay on this device</p>
        <p class="font-mono text-xs text-ink-soft mt-1">JPG, PNG, WebP and iPhone HEIC photos work here.</p>
        <input id="bi-file" type="file" accept="image/*" multiple class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="bi-file" role="status"></p>

      <ul id="bi-list" class="mt-6"></ul>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Output</h2>
          <div id="bi-formats" class="flex gap-2 mt-3 flex-wrap">
            <button class="chip" type="button" data-format="jpeg">JPG</button>
            <button class="chip" type="button" data-format="png">PNG</button>
            <button class="chip" type="button" data-format="webp" aria-pressed="true">WebP</button>
          </div>
          <div class="flex items-center gap-4 mt-3 flex-wrap">
            <span class="flex items-center gap-2">
              <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="bi-quality">Quality (JPG/WebP)</label>
              <input id="bi-quality" type="number" min="1" max="100" step="1" value="80" class="border border-ink bg-ticket px-3 py-2 font-mono w-24" />
            </span>
            <span class="flex items-center gap-2">
              <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="bi-maxwidth">Max width (px, optional)</label>
              <input id="bi-maxwidth" type="number" min="16" max="20000" step="1" placeholder="full size" class="border border-ink bg-ticket px-3 py-2 font-mono w-32" />
            </span>
          </div>
          <p class="text-ink-soft text-sm leading-relaxed mt-3 max-w-md">
            The starting settings come from our own tests: WebP at quality 80 is where our test
            photo beat the biggest converter's result on the same file.
          </p>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="bi-spec" class="mt-2">
            <div class="spec-row"><dt>files on the tray</dt><dd>0</dd></div>
          </dl>
          <button id="bi-run" class="btn-primary w-full mt-5" type="button" disabled>Convert the batch</button>
          <p id="bi-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick images to begin.</p>
        </div>
      </div>

      <div id="bi-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Results</h2>
          <span class="stamp" id="bi-stamp">Done on your device</span>
        </div>
        <div id="bi-rows" class="mt-4 grid gap-1"></div>
        <a id="bi-zip" class="btn-primary inline-block no-underline mt-4 hidden" href="#" download>Download all as one ZIP</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Each photo is decoded by the open-source jSquash codecs, optionally scaled to your
          maximum width, and encoded in the format you picked, one file at a time. In our tests,
          25 images converted in 22.1 seconds total. The sizes are printed per file, before and
          after, so a conversion that grows a file is visible, never silent.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Converting cannot add detail: a small or soft photo stays small and soft in its new
          format, and a JPEG converted to PNG gets bigger, not better; the result line shows
          the bytes either way. AVIF is not offered: our tests measured its encoding at about
          50 seconds a photo. Hidden camera and location data (EXIF) does not survive
          re-encoding, which most people want, but if you need it kept, keep the original. The
          batch was tested with 100 files in one run; past that, the limit is your device's
          memory, not a rule of ours.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/batch-image.js';
  </script>
</Base>
