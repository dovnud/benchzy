---
import Base from '../layouts/Base.astro';

const faq = [
  {
    q: 'How many files can I merge?',
    a: 'As many as your device can hold in memory at once. On our bench, 25 one-page files merged in 71 milliseconds and the result was about 30% smaller than the biggest PDF site produced from the same 25 files. There is no counter here and no per-day allowance.',
  },
  {
    q: 'How do I control the page order?',
    a: 'The merged file follows the list on this page, top to bottom. Move files up and down before you merge. Inside a file, its pages keep their own order.',
  },
  {
    q: 'Does merging change what is on the pages?',
    a: 'No. Pages are copied as they are, not re-drawn or recompressed. Text stays text, and the file sizes add up to roughly the sum of the parts.',
  },
  {
    q: 'Where do my PDFs go?',
    a: 'Nowhere. They are read into this page and merged in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
// HowTo (milestone 5): the steps are this page's own workflow, transcribed
// from its intro, ticket labels and "How it works" text above.
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to merge PDFs into one file",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick your PDFs", text: "Drop PDFs on the tray, or click to pick them. They are read into this page; they are never uploaded." },
    { '@type': 'HowToStep', position: 2, name: "Put the files in order", text: "The merged file follows the list on this page, top to bottom. Use the Up and Down buttons to arrange the pack before you merge. Inside a file, its pages keep their own order." },
    { '@type': 'HowToStep', position: 3, name: "Merge into one PDF", text: "Press 'Merge into one PDF'. The page opens each PDF, copies its pages into a new file in list order, and saves." },
    { '@type': 'HowToStep', position: 4, name: "Download the merged PDF", text: "Take the finished file away. Pages are copied, not rebuilt, so nothing is recompressed and nothing is lost." },
  ],
});
---

<Base title="Merge PDF: put PDFs into one file, free, in your browser · Benchzy" description="Combine as many PDFs as you like into one file, in your order, with the work done inside your browser. No upload, no account, no file-count cap.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Job ticket · PDF bench</p>
      <h1 class="font-display text-4xl font-black mt-2">Merge PDF</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        The monthly pack: invoices, the signed page, the appendix, all in one file. Drop your PDFs
        on the tray, put them in order, and take one file away. Everything runs in your browser;
        the files are never uploaded.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="mg-tool">
      <div id="mg-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick PDFs">
        <p class="font-display text-xl font-bold">Drop PDFs on the tray, or click to pick them</p>
        <p class="font-mono text-xs text-ink-soft mt-2">PDF · as many as you like · they stay on this device</p>
        <input id="mg-file" type="file" accept="application/pdf,.pdf" multiple class="hidden" />
      </div>

      <ul id="mg-list" class="mt-6"></ul>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">The order is the list</h2>
          <p class="text-ink-soft text-sm leading-relaxed mt-3 max-w-md">
            Files merge top to bottom. Use the Up and Down buttons to arrange the pack before you
            run the job; you can add more files at any point, and take files off the tray.
          </p>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="mg-spec" class="mt-2">
            <div class="spec-row"><dt>files on the tray</dt><dd>0</dd></div>
          </dl>
          <button id="mg-run" class="btn-primary w-full mt-5" type="button" disabled>Merge into one PDF</button>
          <p id="mg-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick two or more PDFs to begin.</p>
        </div>
      </div>

      <div id="mg-result" class="hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="mg-stamp">Done on your device</span>
        </div>
        <p id="mg-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="mg-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the merged PDF</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The page opens each PDF, copies its pages into a new file in list order, and saves. Pages
          are copied, not rebuilt, so nothing is recompressed and nothing is lost. It is the fastest
          job on this bench: the whole 25-file test pack took 71 milliseconds of engine time.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The limit is your device's memory, not a rule of ours: a tray of very large files on a
          small phone can run out of room, and if that happens your originals are unchanged. A file
          this page cannot read as a PDF is marked on the list and left out of the merge, in plain
          words, before you run the job. Check the merged order before you send the pack on.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/merge-pdf.js';
  </script>
</Base>
