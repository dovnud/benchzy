---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'What is this page for, when there are JPG and PNG doors too?',
    a: 'Mixed sets. A phone screenshot (PNG), a camera photo (JPG), a picture saved off a website (WebP) and an iPhone photo (HEIC) can all go into the same PDF here, in one list, in your order. The single-kind doors are next door: JPG to PDF and PNG to PDF.',
  },
  {
    q: 'Do my pictures lose quality when they become a PDF?',
    a: 'JPG and PNG pictures are placed into the PDF exactly as they are stored, with no recompression. A WebP or HEIC picture is rebuilt as a PNG inside the PDF, because a PDF cannot hold either; PNG keeps every pixel, so the picture is unchanged, and the result line says when a rebuild happened.',
  },
  {
    q: 'How do the pictures map to pages?',
    a: 'One picture per page, in the order on the list: the first picture becomes page 1. Move pictures up and down the list before you run, and the pages follow the list.',
  },
  {
    q: 'Where do my pictures go?',
    a: 'Nowhere. They are read into this page and built into a PDF in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to turn mixed pictures into one PDF",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick the pictures", text: "Drop JPG, PNG, WebP or HEIC pictures on the tray, in any mixture, or click to pick them. They stay on this device, and the list shows each picture's real pixel size." },
    { '@type': 'HowToStep', position: 2, name: "Put them in order", text: "Move pictures up and down the list: the first picture becomes page 1, the second page 2, and so on. Pick whether each page is sized to its picture or the pictures are fitted onto A4 or Letter sheets." },
    { '@type': 'HowToStep', position: 3, name: "Build the PDF", text: "Press 'Build the PDF'. The pictures are placed into one PDF, one per page, in your browser; JPG and PNG pictures go in exactly as stored, WebP and HEIC pictures are rebuilt as PNG inside the file." },
    { '@type': 'HowToStep', position: 4, name: "Download the PDF", text: "Take the finished file away. The result line reports the page count the finished file actually holds." },
  ],
});
---

<Base title="Image to PDF: mixed pictures into one PDF, free · Benchzy" description="Turn a mixed set of JPG, PNG, WebP and HEIC pictures into one PDF, one picture per page, in your order, inside your browser. Nothing is uploaded.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">PDF tools · convert</p>
      <h1 class="font-display text-4xl font-black mt-2">Image to PDF</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Turn a mixed set of pictures into one PDF: JPG, PNG, WebP and iPhone HEIC pictures
        in the same list, one picture per page, in the order you put them. Everything runs
        in your browser; the pictures are never uploaded. Sets of one kind have their own
        doors: <a class="underline underline-offset-4 hover:text-accent-deep" href="/jpg-to-pdf/">JPG to PDF</a>
        and <a class="underline underline-offset-4 hover:text-accent-deep" href="/png-to-pdf/">PNG to PDF</a>.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="jp-tool" data-kinds="jpeg,png,webp,heic" data-kinds-label="JPG, PNG, WebP or HEIC" data-preset-key="image-to-pdf" data-download-name="images-benchzy.pdf" data-tool-name="Image to PDF">
      <div id="jp-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick pictures">
        <p class="font-display text-xl font-bold">Drop pictures on the tray, or click to pick them</p>
        <p class="font-mono text-xs text-ink-soft mt-2">JPG · PNG · WebP · HEIC · they stay on this device</p>
        <input id="jp-file" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.heic,.heif" multiple class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="jp-file" role="status"></p>

      <ul id="jp-list" class="mt-6"></ul>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Page fit</h2>
          <div class="mt-3 grid gap-3">
            <label class="flex items-baseline gap-2">
              <input type="radio" name="jp-fit" value="own" checked />
              <span>Each page sized to its picture (no border, no scaling)</span>
            </label>
            <label class="flex items-baseline gap-2">
              <input type="radio" name="jp-fit" value="a4" />
              <span>Fit the pictures onto A4 pages, centred, with a half-inch border</span>
            </label>
            <label class="flex items-baseline gap-2">
              <input type="radio" name="jp-fit" value="letter" />
              <span>Fit the pictures onto Letter pages, centred, with a half-inch border</span>
            </label>
          </div>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="jp-spec" class="mt-2">
            <div class="spec-row"><dt>pictures on the tray</dt><dd>0</dd></div>
          </dl>
          <p class="action-note">
            The order on the list is the page order: the first picture becomes page 1.
            A picture that is none of those four kinds is named on the list and left out.
          </p>
          <button id="jp-run" class="btn-primary w-full mt-5" type="button" disabled>Build the PDF</button>
          <p id="jp-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick one or more pictures to begin.</p>
        </div>
      </div>

      <div id="jp-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="jp-stamp">Done on your device</span>
        </div>
        <p id="jp-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="jp-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the PDF</a>
      </div>
    </section>

    <StepsStrip who="For the real shape of a photo pile: some JPGs off a camera, a PNG screenshot or two, a WebP saved from a site and an HEIC off an iPhone, all bound for one form, one email or one archive file." steps={[{ n: '01', t: 'Pick the mixed pictures' }, { n: '02', t: 'Put them in order and pick the page fit' }, { n: '03', t: 'Build and download the PDF' }]} />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Each picture is placed into the PDF one per page, in list order. JPG and PNG
          pictures go in exactly as stored. A PDF cannot hold a WebP or a HEIC picture, so
          those two are rebuilt as PNG inside the file first, by the same image program the
          convert doors run; PNG is lossless, so the picture itself is unchanged, and the
          result line says how many were rebuilt. The download is how we protect your
          privacy: the program that does this job is part of this page, loaded from this
          site, and your pictures are read into the page and never uploaded. The finished
          file is opened again and its pages counted, so the result line reports the
          file's own numbers, not the plan.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          One picture per page: this page does not lay several pictures out on one sheet,
          and it does not shrink anything, so a PDF made of full-size phone photos is a
          full-size file. If the document then has to fit under a size limit, run it through
          the <a class="underline underline-offset-4" href="/compress-pdf/">compress PDF tool</a> next.
          A HEIC photo is decoded at its stored size and stands upright in the PDF, the way
          the <a class="underline underline-offset-4" href="/heic-to-jpg/">HEIC to JPG page</a> handles it.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/jpg-to-pdf.js';
  </script>
</Base>
