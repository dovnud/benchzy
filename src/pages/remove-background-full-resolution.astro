---
import Base from '../layouts/Base.astro';
import BgTicket from '../components/BgTicket.astro';
import StepsStrip from '../components/StepsStrip.astro';
import LangLinks from '../components/LangLinks.astro';

const alternates = [
  { hreflang: 'en', href: '/remove-background-full-resolution/' },
  { hreflang: 'es', href: '/es/quitar-fondo-resolucion-completa/' },
  { hreflang: 'pt-BR', href: '/pt-br/alternativa-gratis-ao-remove-bg/' },
  { hreflang: 'x-default', href: '/remove-background-full-resolution/' },
];
const langLinks = [
  { label: 'English', href: '/remove-background-full-resolution/', current: true },
  { label: 'Español', href: '/es/quitar-fondo-resolucion-completa/' },
  { label: 'Português (Brasil)', href: '/pt-br/alternativa-gratis-ao-remove-bg/' },
];

const faq = [
  {
    q: 'What does full resolution mean here?',
    a: 'The cutout comes out at the same pixel size as the photo you put in. A 4000 by 3000 photo gives a 4000 by 3000 cutout. There is no smaller free size and no bigger paid size, because there is only one size: yours.',
  },
  {
    q: 'How is that different from remove.bg?',
    a: 'In our live test on 7 November 2026, remove.bg free gave back 577 by 433 pixels from a 1200 by 900 photo, about a quarter of the pixels, and full size there costs a credit per photo. That service is also closing on 1 December 2026. Here the full size is the only size, and it is free.',
  },
  {
    q: 'Can I use the cutout for my shop or business?',
    a: 'Yes. Output from this page carries no licence restriction from us, for personal or business work. Contrast, from remove.bg terms as read in November 2026: its free results are for private, non-commercial use only.',
  },
  {
    q: 'Is there a catch with the first run?',
    a: 'The first run downloads the removal program, 44.3 MB, in 11 pieces that your browser checks one by one. That is printed here, not hidden. After that the program is saved on your device and later visits start at once. The 44.3 MB counts against mobile data on a phone, so the first run is better on Wi-Fi; on a slow connection the load can take a minute or more, and it can be cancelled while it runs: pieces already downloaded are kept, and the next run carries on from there.',
  },
  {
    q: 'How long does a cutout take?',
    a: 'In warm runs on our desktop-class test computer, 9.7 to 10.6 seconds a photo once the program is downloaded; the first photo of a session runs slower. We have not measured phones, so this page makes no phone promise.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
// HowTo (milestone 5): the steps are this page's own workflow, transcribed
// from its intro, ticket labels and "How it works" text above.
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to remove a background at full resolution",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick a photo", text: "Drop a photo on the tray, or click to pick one. Your photo is read into this page and never uploaded." },
    { '@type': 'HowToStep', position: 2, name: "Remove the background", text: "Press 'Remove the background'. The first time, your browser downloads the removal program (44.3 MB, in 11 checked pieces)." },
    { '@type': 'HowToStep', position: 3, name: "Full size is the only size", text: "The cutout is produced at the same pixel dimensions as your photo, because the work runs in your browser and costs this site nothing per photo. There are no credits, no account and no paid tier hiding the real output." },
    { '@type': 'HowToStep', position: 4, name: "Download the full-size cutout (PNG)", text: "Drag on the picture to compare before and after, then take the full-size cutout away." },
  ],
});
---

<Base title="Free background remover, full resolution · Benchzy" description="Remove a photo background at full resolution, free, in your browser. The size you upload is the size you download. No credits, no account, no smaller free tier." alternates={alternates}>
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Background removal · full resolution</p>
      <h1 class="font-display text-4xl font-black mt-2">Free background remover, full resolution</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Full size is the only size here. The cutout is produced at the same pixel dimensions as
        your photo, because the work runs in your browser and costs this site nothing per photo.
        There are no credits, no account and no paid tier hiding the real output.
      </p>
      <LangLinks label="This page in:" links={langLinks} />
    </section>

    <StepsStrip who="For print, large displays, or any job where a small cutout would show: the cutout at your photo's own full size." steps={[{ n: '01', t: 'Pick a photo' }, { n: '02', t: 'Remove the background' }, { n: '03', t: 'Download the full-size cutout' }]} />

    <BgTicket locale="en" full />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Why full size can be free</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Sites that cut out photos on their own servers pay for every photo, so they ration the
          real output: a small free preview, full size for a fee. This page runs the same kind of
          program inside your browser instead. Your device does the work, the photo never leaves
          it, and a cutout costs this site nothing, so there is nothing to ration and no size to
          hold back. The plain version of that deal is on the
          <a class="underline underline-offset-4" href="/what-free-means/">what free means here</a> page.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Hair, glass and see-through edges are good but not perfect. Very large photos can run
          out of memory on small phones. The first download is 44.3 MB and it is printed on this
          page rather than sprung on you at the download button. Our measured facts about the
          famous alternative, with dates, are on the
          <a class="underline underline-offset-4" href="/vs-remove-bg/">Benchzy vs remove.bg</a> page.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/remove-bg.js';
  </script>
</Base>
