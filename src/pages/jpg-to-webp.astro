---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';
import ConvertDoor from '../components/ConvertDoor.astro';

const faq = [
  {
    q: 'How much smaller will it be?',
    a: 'It depends on the photo, but the direction is reliable. Measured with this same engine on the batch convert page: the test photo as WebP at quality 80 came out at 251,730 bytes, against 435,388 bytes from the biggest converter on the same file. Your result line prints your own before and after.',
  },
  {
    q: 'Does converting a JPG to WebP lose quality?',
    a: 'It is a second lossy write over a picture that was already written lossily once, so yes, a little, and the page will not hide it. Keep the quality high (90 is the starting setting) and keep the JPG if it is your master copy.',
  },
  {
    q: 'Where is WebP the right choice?',
    a: 'On websites, where every modern browser reads it and smaller photos mean faster pages. It is the wrong choice for sending to older programs or print queues that may refuse it; for those, the JPG you already have is the right file.',
  },
  {
    q: 'Where does my file go?',
    a: 'Nowhere. It is decoded, re-encoded and offered back to you inside this page. Nothing is uploaded.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to convert a JPG to a WebP",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick a JPG", text: "Drop a JPG on the tray, or click to pick one. It stays on this device. A file in the wrong format is pointed at the right door." },
    { '@type': 'HowToStep', position: 2, name: "Set the quality", text: "Pick the quality for the WebP; 90 is the starting setting, and the result line prints the bytes before and after." },
    { '@type': 'HowToStep', position: 3, name: "Convert to WebP", text: "Press 'Convert to WebP'. The JPG is decoded and written as a WebP here in the page, by the same engine the batch convert page runs." },
    { '@type': 'HowToStep', position: 4, name: "Download the WebP", text: "Download the WebP at the dimensions and size the result line states." },
  ],
});
---

<Base title="JPG to WebP: convert a JPG to a WebP, free, in your browser · Benchzy" description="Convert one JPG to a WebP inside your browser: smaller photos for websites, at a quality you pick, with the before and after bytes printed. No upload, no account, no conversion minutes.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Image tools · convert</p>
      <h1 class="font-display text-4xl font-black mt-2">JPG to WebP</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        A website wants its photos light. This door converts one JPG to a WebP, the format
        modern browsers read and the one that usually weighs least, here in your browser.
        It is a fresh lossy write over an already-lossy picture, so the quality setting
        matters and the result line prints the bytes before and after. A whole folder at
        once is the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/batch-convert-images/">batch convert page</a>;
        the reverse trip is <a class="underline underline-offset-4 hover:text-accent-deep" href="/webp-to-jpg/">WebP to JPG</a>.
      </p>
    </section>

    <StepsStrip who="For one JPG headed for a website: a blog photo, a product shot, a page image that has to load fast." steps={[{ n: '01', t: 'Pick a JPG' }, { n: '02', t: 'Set the quality' }, { n: '03', t: 'Download the WebP' }]} />

    <ConvertDoor from="jpeg" to="webp" note="The weight changes, and the dimensions do not. WebP writes the same picture in fewer bytes than JPG at a like quality; the exact saving depends on the photo, and the result line prints yours. One caution, printed before you run: this is a second lossy write over the JPG, so keep the quality high." />

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The JPG is decoded by the open-source jSquash codecs and written as a WebP at your
          quality, the same engine the batch convert page runs. The first run loads the
          image program (about 2 MB, one time only). The download is how we protect your
          privacy: the program comes to your device and does the work there, so your file
          never leaves it.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          WebP is for screens and browsers. Older editors, some office programs and print
          queues still refuse it, so it is the wrong format to send into the unknown; the
          WebP to JPG door exists for exactly that trip back. And the saving is not magic on
          every photo: a small or already-tightly-written JPG may barely shrink, and the
          result line shows the number either way.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/convert-image.js';
  </script>
</Base>
