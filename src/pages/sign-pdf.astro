---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'Is this a legal e-signature?',
    a: 'No, and the page says so before you start. This places your signature on your own document, drawn into the page itself. It has no certificate, no audit trail and no identity check, so it is not a substitute where a certified e-signature is required. For the everyday jobs (signing a form, an agreement copy, a school permission slip) it is exactly what it looks like: your signature, on the page.',
  },
  {
    q: 'Can I ask other people to sign?',
    a: 'No. Sending signing requests, tracking who signed and issuing certificates are things a server has to do, and this site has no server in the job. Suites that sell that are selling the server work, not the drawing of the signature.',
  },
  {
    q: 'Can the signature be peeled off afterwards?',
    a: 'The signature is drawn into the page content, the way ink sits on paper, not attached as a movable sticker annotation. Anyone with a full PDF editor and enough determination can alter any PDF, signed or not; what this page does not do is leave the signature floating on top as a separate layer.',
  },
  {
    q: 'Where does my document go?',
    a: 'Nowhere. It is read into this page and signed in your browser; the signature you draw never leaves the page either. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to sign a PDF with your own signature",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick the PDF", text: "Drop a PDF on the tray, or click to pick one. It stays on this device." },
    { '@type': 'HowToStep', position: 2, name: "Make your signature", text: "Draw it on the pad with mouse, finger or pen, or type your name and have it set in a signature style. Add initials and the date if the document wants them." },
    { '@type': 'HowToStep', position: 3, name: "Choose the placement", text: "Pick the page (first, last or every page), the corner, and the signature's size." },
    { '@type': 'HowToStep', position: 4, name: "Sign and download", text: "Press 'Sign the PDF'. The signature is drawn into the page itself, and you download the signed file." },
  ],
});
---

<Base title="Sign PDF: your signature on your document, free · Benchzy" description="Draw or type your signature and place it on your own PDF, inside your browser. Plainly scoped: no signing requests, no certificates, no legal e-signature claims.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">PDF tools · sign</p>
      <h1 class="font-display text-4xl font-black mt-2">Sign PDF</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Your signature, on your document, placed as part of the page. Draw it or type it,
        put it where it belongs, and take the signed file away. Everything runs in your
        browser; the document is never uploaded.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="sg-tool">
      <div id="sg-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick a PDF">
        <p class="font-display text-xl font-bold">Drop a PDF on the tray, or click to pick one</p>
        <p class="font-mono text-xs text-ink-soft mt-2">PDF · it stays on this device</p>
        <input id="sg-file" type="file" accept="application/pdf,.pdf" class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="sg-file" role="status"></p>

      <div class="grid gap-6 mt-6 md:grid-cols-2">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Your signature</h2>
          <div class="flex gap-4 mt-3">
            <label class="flex items-baseline gap-2">
              <input type="radio" name="sg-source" value="draw" checked />
              <span>Draw it</span>
            </label>
            <label class="flex items-baseline gap-2">
              <input type="radio" name="sg-source" value="type" />
              <span>Type it</span>
            </label>
          </div>
          <canvas id="sg-pad" width="520" height="180" class="mt-3 w-full border border-ink bg-ticket" style="touch-action: none;" aria-label="Signature pad"></canvas>
          <div class="flex items-center gap-2 mt-2 flex-wrap">
            <button id="sg-clear" class="chip" type="button">Clear the pad</button>
            <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="sg-typed">Or type your name</label>
            <input id="sg-typed" type="text" maxlength="60" placeholder="Your name" class="border border-ink bg-ticket px-3 py-2 font-mono w-52" />
          </div>
          <p class="action-note">
            A typed signature is your name set in a signature style. It is not a copy of your
            hand, and it does not become one by being placed on the page. If the document needs
            your hand, draw it.
          </p>

          <div class="flex gap-4 mt-3 flex-wrap">
            <span class="font-mono text-xs uppercase tracking-widest text-ink-soft self-center">Ink</span>
            <label class="flex items-baseline gap-2"><input type="radio" name="sg-ink" value="ink" checked /><span>Workshop ink</span></label>
            <label class="flex items-baseline gap-2"><input type="radio" name="sg-ink" value="black" /><span>Black</span></label>
            <label class="flex items-baseline gap-2"><input type="radio" name="sg-ink" value="blue" /><span>Blue</span></label>
          </div>
          <div class="flex items-center gap-4 mt-4 flex-wrap">
            <span class="flex items-center gap-2">
              <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="sg-initials">Initials (optional)</label>
              <input id="sg-initials" type="text" maxlength="6" placeholder="A.N." class="border border-ink bg-ticket px-3 py-2 font-mono w-24" />
            </span>
            <label class="flex items-baseline gap-2">
              <input id="sg-date" type="checkbox" checked />
              <span>Add today's date near the signature</span>
            </label>
          </div>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Placement</h2>
          <div class="grid gap-2 mt-3">
            <span class="font-mono text-xs uppercase tracking-widest text-ink-soft">Page</span>
            <div class="flex gap-4 flex-wrap">
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-page" value="last" checked /><span>Last page</span></label>
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-page" value="first" /><span>First page</span></label>
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-page" value="all" /><span>Every page</span></label>
            </div>
            <span class="font-mono text-xs uppercase tracking-widest text-ink-soft mt-2">Corner</span>
            <div class="flex gap-4 flex-wrap">
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-pos" value="br" checked /><span>Bottom right</span></label>
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-pos" value="bl" /><span>Bottom left</span></label>
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-pos" value="tr" /><span>Top right</span></label>
              <label class="flex items-baseline gap-2"><input type="radio" name="sg-pos" value="tl" /><span>Top left</span></label>
            </div>
            <span class="flex items-center gap-2 mt-2">
              <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="sg-size">Signature width (points)</label>
              <input id="sg-size" type="number" min="90" max="260" step="10" value="170" class="border border-ink bg-ticket px-3 py-2 font-mono w-24" />
            </span>
          </div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft mt-6">File spec</h2>
          <dl id="sg-spec" class="mt-2">
            <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
          </dl>
          <button id="sg-run" class="btn-primary w-full mt-5" type="button" disabled>Sign the PDF</button>
          <p id="sg-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick a PDF to begin.</p>
        </div>
      </div>

      <div id="sg-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="sg-stamp">Done on your device</span>
        </div>
        <p id="sg-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="sg-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the signed PDF</a>
      </div>
    </section>

    <StepsStrip who="For signing your own document: a permission form, an agreement, a school slip. Self-signing only." steps={[{ n: '01', t: 'Pick the PDF' }, { n: '02', t: 'Make your signature' }, { n: '03', t: 'Place it and download' }]} />

    <section class="ticket-soft mt-6 p-5">
      <h2 class="font-display text-xl font-bold">What this is, and what it is not</h2>
      <p class="mt-2 leading-relaxed text-ink-soft max-w-3xl">
        This is <strong>self-signing</strong>: your own signature on your own document. It is
        <strong>not</strong> a legal e-signature service. It sends no signing requests to other
        people, keeps no audit trail, and issues no certificate of completion. Where a contract
        or an authority requires a certified e-signature, use one of those services; the suites
        charge for exactly that server work. The line is printed here, before you pick a file,
        so the tool is never mistaken for more than it is.
      </p>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Your drawn or typed signature becomes a small transparent picture, which the PDF
          engine draws straight into the chosen pages at the corner and size you picked,
          alongside your initials and the date when you ask for them. Because it is drawn into
          the page content, the signed file prints and displays the same everywhere.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Placement is by corner and size, not by finding the signature line in your document:
          this page does not read your file, so check the signed copy before you send it on,
          especially on forms with small signature boxes. A typed signature is your name set in
          a signature style, not a copy of your hand; where a document needs your actual hand,
          draw it.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">A password-protected PDF cannot be opened by this tool. Take its password off first with the <a class="underline underline-offset-4" href="/unlock-pdf/">unlock tool</a>, then bring the file back.</p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/sign-pdf.js';
  </script>
</Base>
