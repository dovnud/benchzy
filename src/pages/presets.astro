---
import Base from '../layouts/Base.astro';

const presets = [
  {
    id: 'starter-invoice-pack',
    name: 'Invoice pack',
    steps: 'Merge all PDFs into one → Compress PDF to 500 KB',
    job: 'The monthly bundle: a folder of invoices and receipts becomes one file that fits the email limit or the portal door.',
  },
  {
    id: 'starter-portal-pack',
    name: 'Portal pack',
    steps: 'Compress PDF to 200 KB',
    job: 'Every PDF in the folder, worked to the tight 200 KB door that government and university portals set, each file separately.',
  },
  {
    id: 'starter-paid-pack',
    name: 'Paid pack',
    steps: 'Merge all PDFs into one → Stamp "PAID IN FULL" on every page → Compress PDF to 500 KB',
    job: 'The settled-accounts bundle: join the pack, mark every page paid, and shrink the result to a size that sends well.',
  },
  {
    id: 'starter-seller-photos',
    name: 'Seller photos',
    steps: 'Compress image to 200 KB',
    job: 'A product shoot at listing size: every photo worked to 200 KB in one run, ready for the shop that asked for them.',
  },
];
---

<Base title="Preset chains: ready-made workflows for the weekly jobs · Benchzy" description="One-click workflow chains for the jobs people repeat: the invoice pack, the portal pack, the paid pack, seller photos. Save one, run it on your files in the workflows bench.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Hub · the workbench · preset chains</p>
      <h1 class="font-display text-4xl font-black mt-2">Preset chains</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Ready-made <a class="underline underline-offset-4 hover:text-accent-deep" href="/workflows/">workflow chains</a> for the
        jobs that come back every week. Save one to this browser with a click, then run it on
        the workflows bench whenever the job lands again. Building your own chain from single
        steps is on the same bench.
      </p>
    </section>

    <section class="mt-6 grid gap-4">
      {presets.map((p) => (
        <article class="ticket-soft p-5 flex flex-wrap items-baseline gap-3">
          <h2 class="font-display text-xl font-bold">{p.name}</h2>
          <span class="font-mono text-xs uppercase tracking-widest text-ink-soft border border-line px-2 py-1">{p.steps}</span>
          <p class="w-full text-ink-soft leading-relaxed">{p.job}</p>
          <a class="btn-primary no-underline mt-1" href="/workflows/" data-preset={p.id}>Save this chain</a>
          <p class="w-full font-mono text-xs text-ink-soft" data-preset-note={p.id}>Saving keeps the chain in this browser only. Files are never stored.</p>
        </article>
      ))}
    </section>

    <section class="ticket mt-12 p-6 mb-4">
      <h2 class="font-display text-2xl font-bold">Why chains live here</h2>
      <p class="mt-3 leading-relaxed text-ink-soft max-w-2xl">
        Chained jobs are a paid-plan feature on the leading PDF suite, because every step
        costs a server money. Here every step runs on your own device, so the chain costs this
        site nothing per run. That is the whole trick of this workshop, stated plainly on the
        <a class="underline underline-offset-4" href="/what-free-means/">what free means here</a> page.
      </p>
    </section>
  </div>
  <script>
    import '../scripts/presets.js';
  </script>
</Base>
