---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'What does the batch add to splitting?',
    a: 'One rule, many files. The range you set, say pages 1 to 2 for the signed cover sheet of every contract, is cut from every PDF on the tray in one run. On the big suites, running one job over many files is a paid extra; here it is the ordinary way this page works.',
  },
  {
    q: 'What if the range does not fit a file?',
    a: 'The range is clamped to the file: a "pages 1 to 5" rule on a 3-page file gives its 3 pages. A file where the range cannot apply at all is listed as skipped, with the reason, and the rest of the batch carries on.',
  },
  {
    q: 'Does splitting change the pages?',
    a: 'No. Pages are copied as they are, not re-drawn or recompressed. A page that goes in as text comes out as text.',
  },
  {
    q: 'Where do my PDFs go?',
    a: 'Nowhere. They are read into this page and cut in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to split many PDFs with one page range",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick your PDFs", text: "Drop PDFs on the tray, or click to pick them. They are read into this page; they are never uploaded." },
    { '@type': 'HowToStep', position: 2, name: "Set the one range", text: "Set the from page and to page once. The same range is cut from every file; leave the to page empty to run to each file's own end." },
    { '@type': 'HowToStep', position: 3, name: "Run the batch", text: "Press 'Cut the batch'. Each file is opened, the range is copied into a new PDF, and every result gets its own line." },
    { '@type': 'HowToStep', position: 4, name: "Download the results", text: "Download files one by one, or take the whole batch away as a single ZIP." },
  ],
});
---

<Base title="Batch split PDF: cut the same pages from many PDFs, free · Benchzy" description="Apply one page range to a whole folder of PDFs in a single run, inside your browser. Per-file results, one ZIP download. No upload, no account, no file-count cap.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">PDF tools · batch</p>
      <h1 class="font-display text-4xl font-black mt-2">Batch split PDF</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Every file in the folder needs the same cut: the first two pages, the signed last page,
        the appendix. Set the range once and it is cut from every PDF in one run. One file at a
        time, with more ways to cut, is on the
        <a class="underline underline-offset-4 hover:text-accent-deep" href="/split-pdf/">Split PDF page</a>.
      </p>
    </section>

    <StepsStrip who="For the same pages cut out of many files at once: the signed page from every contract, the first page of every statement." steps={[{ n: '01', t: 'Pick your PDFs' }, { n: '02', t: 'Set the one range' }, { n: '03', t: 'Run and download the results' }]} />

    <section class="ticket mt-6 p-5 sm:p-7" id="bp-tool" data-mode="split">
      <div id="bp-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick PDFs">
        <p class="font-display text-xl font-bold">Drop PDFs on the tray, or click to pick them</p>
        <p class="font-mono text-xs text-ink-soft mt-2">PDF · as many as your device can hold · they stay on this device</p>
        <input id="bp-file" type="file" accept="application/pdf,.pdf" multiple class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="bp-file" role="status"></p>

      <ul id="bp-list" class="mt-6"></ul>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">The one range</h2>
          <div class="flex items-center gap-2 mt-3 flex-wrap">
            <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="bp-from">From page</label>
            <input id="bp-from" type="number" min="1" step="1" value="1" class="border border-ink bg-ticket px-3 py-2 font-mono w-24" />
            <label class="font-mono text-xs uppercase tracking-widest text-ink-soft" for="bp-to">To page</label>
            <input id="bp-to" type="number" min="1" step="1" placeholder="end" class="border border-ink bg-ticket px-3 py-2 font-mono w-24" />
          </div>
          <p class="text-ink-soft text-sm leading-relaxed mt-3 max-w-md">
            The range is clamped to each file, so a short file gives what it has. Leave "to
            page" empty to run to each file's own last page.
          </p>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="bp-spec" class="mt-2">
            <div class="spec-row"><dt>files on the tray</dt><dd>0</dd></div>
          </dl>
          <button id="bp-run" class="btn-primary w-full mt-5" type="button" disabled>Cut the batch</button>
          <p id="bp-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick PDFs to begin.</p>
        </div>
      </div>

      <div id="bp-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Results</h2>
          <span class="stamp" id="bp-stamp">Done on your device</span>
        </div>
        <div id="bp-rows" class="mt-4 grid gap-1"></div>
        <a id="bp-zip" class="btn-primary inline-block no-underline mt-4 hidden" href="#" download>Download all as one ZIP</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Each file is opened in turn, the range is copied into a new PDF, and the result joins
          the list with its page count and size. Nothing is re-drawn, so every cut is exact, and
          the engine time per file is measured in milliseconds in our tests.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The range is a page rule, not a reading of the documents: this page deals pages by
          number and does not check what is on them, so check a cut or two before you send a
          batch on. A file that is not a readable PDF is listed as skipped, never silently
          dropped.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">A password-protected PDF cannot be opened by this tool. Take its password off first with the <a class="underline underline-offset-4" href="/unlock-pdf/">unlock tool</a>, then bring the file back.</p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/batch-pdf.js';
  </script>
</Base>
