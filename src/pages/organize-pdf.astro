---
import Base from '../layouts/Base.astro';
import StepsStrip from '../components/StepsStrip.astro';

const faq = [
  {
    q: 'Does organising change what is on the pages?',
    a: 'No. Pages are moved inside the file, never rebuilt or re-encoded: words, pictures and filled form answers come through exactly as they were, at the same quality. Only the order of the page list changes.',
  },
  {
    q: 'I removed a page. Why is the file not smaller?',
    a: 'Removing a page takes it out of the document\'s reading order, but its contents stay inside the file\'s storage. That is the price of not rebuilding the document: nothing else in the file can be damaged by the removal, and the file stays valid. If a smaller file is the job, run the finished file through the compress tool.',
  },
  {
    q: 'What happens to bookmarks and links?',
    a: 'A bookmark that points at a page keeps pointing at that same page after it moves, because kept pages keep their identity inside the file. A bookmark that points at a page you removed stays in the bookmark list but leads nowhere, because its page is no longer in the document.',
  },
  {
    q: 'Can I put the same page in twice?',
    a: 'Yes. Press Copy on a page and the copy takes the next place in the order. One honest catch for forms: a copied page shows the filled answer it carried, but the form field itself is registered once, on the original page. Fill a form, or flatten it, before organising if every copy needs to stay an editable field.',
  },
  {
    q: 'Where does my document go?',
    a: 'Nowhere. It is read into this page and organised in your browser. Watch the network panel while it works if you want to check.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const howToJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: "How to remove and organise PDF pages",
  step: [
    { '@type': 'HowToStep', position: 1, name: "Pick the PDF", text: "Drop a PDF on the tray, or click to pick one. It stays on this device. The page lays out a picture of every page before anything runs." },
    { '@type': 'HowToStep', position: 2, name: "Arrange the pages", text: "Drag pages into order, or use the Earlier and Later buttons. Remove takes a page out of the document; Copy puts a second copy of a page in. At least one page always stays." },
    { '@type': 'HowToStep', position: 3, name: "Build the organised PDF", text: "Press 'Build the organised PDF'. The page list inside the file is rewritten in your order; the pages themselves are not rebuilt." },
    { '@type': 'HowToStep', position: 4, name: "Download the organised PDF", text: "Take the finished file away. The result line prints the new order in your original page numbers." },
  ],
});
---

<Base title="Remove and organise PDF pages, free, in your browser · Benchzy" description="Take pages out of a PDF, change their order, or copy a page, inside your browser. Pages move inside the file and are never rebuilt, so nothing is re-encoded and nothing is uploaded.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">PDF tools · pages</p>
      <h1 class="font-display text-4xl font-black mt-2">Remove and organise pages</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Lay a PDF's pages out in front of you, take the ones you do not need out, drag the
        rest into the right order, and copy a page if it belongs in twice. Everything runs
        in your browser; the document is never uploaded.
      </p>
    </section>

    <StepsStrip who="For a report with the appendix in the middle, a scan with two pages swapped, or a pack that needs the same page twice." steps={[{ n: '01', t: 'Pick the PDF' }, { n: '02', t: 'Arrange the pages' }, { n: '03', t: 'Build and download' }]} />

    <section class="ticket mt-6 p-5 sm:p-7" id="og-tool">
      <div id="og-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick a PDF">
        <p class="font-display text-xl font-bold">Drop a PDF on the tray, or click to pick one</p>
        <p class="font-mono text-xs text-ink-soft mt-2">PDF · it stays on this device</p>
        <input id="og-file" type="file" accept="application/pdf,.pdf" class="hidden" />
      </div>
      <p class="file-loaded hidden" data-loaded-for="og-file" role="status"></p>

      <div class="mt-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
        <dl id="og-spec" class="mt-2">
          <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
        </dl>
      </div>

      <div id="og-pages" class="grid gap-3 mt-6 sm:grid-cols-2 lg:grid-cols-3"></div>
      <p id="og-last-note" class="action-note hidden">
        At least one page has to stay in the document, so the last page cannot be removed.
        A document with no pages is not a document.
      </p>

      <p class="action-note">
        Pages are moved inside the file, not rebuilt: what a page carries comes through
        exactly, and the document's own details, bookmarks and attachments stay attached.
        The honest limits are written out below, before you run.
      </p>
      <button id="og-run" class="btn-primary w-full mt-5" type="button" disabled>Build the organised PDF</button>
      <p id="og-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick a PDF to begin.</p>

      <div id="og-result" class="receipt hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="og-stamp">Done on your device</span>
        </div>
        <p id="og-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="og-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the organised PDF</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Are the pages rebuilt? No. Pages are moved inside the file, never rebuilt or
          re-encoded: words, pictures and filled form answers come through exactly as they
          were, at the same quality. Only the order of the page list changes. Anything a
          page shares with the rest of the document is written onto the page itself before
          it moves, so nothing a page needs can be left behind; we checked this against
          files built exactly that way, against a filled form, and against a document with
          bookmarks. The download is how we protect your privacy: the program that does
          this job is part of this page, loaded from this site, and your file is read into
          the page and never uploaded. The finished file is opened again and its pages
          counted, so the result line reports the file's own numbers, not the plan.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Removing a page takes it out of the reading order, but its contents stay inside
          the file's storage, so the finished file may be no smaller. A bookmark pointing
          at a removed page stays in the list and leads nowhere. A copied page shows the
          form answers it carried, but the field itself stays registered on the original
          page. A signed document's signatures will no longer verify after any re-save,
          this one included, so organise the working copy, not the signed original.
        </p>
        <p class="mt-3 leading-relaxed text-ink-soft">A password-protected PDF cannot be opened by this tool. Take its password off first with the <a class="underline underline-offset-4" href="/unlock-pdf/">unlock tool</a>, then bring the file back.</p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script type="application/ld+json" set:html={howToJson}></script>
  <script>
    import '../scripts/organize-pdf.js';
  </script>
</Base>
