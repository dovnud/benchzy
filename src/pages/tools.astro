---
import Base from '../layouts/Base.astro';

const families = [
  {
    name: 'Background removal',
    hub: '/background-removal/',
    tools: [
      { name: 'Remove background', href: '/remove-background/', live: true, note: 'Full-size cutouts in your browser. First run downloads the program (44.3 MB, printed before it loads).' },
      { name: 'Free background remover, full resolution', href: '/remove-background-full-resolution/', live: true, note: 'The same bench with the full-size promise in plain words, and the dated facts about the famous alternative.' },
      { name: 'Quitar fondo de imagen gratis', href: '/es/quitar-fondo-de-imagen-gratis/', live: true, note: 'La herramienta en español, con su página a resolución completa. Spanish strings drafted in-house, marked pending human review in the project notes.' },
      { name: 'Remover fundo de imagem grátis', href: '/pt-br/remover-fundo-de-imagem-gratis/', live: true, note: 'A ferramenta em português, com a página de alternativa grátis ao remove.bg. Portuguese strings drafted in-house, marked pending human review in the project notes.' },
    ],
  },
  {
    name: 'PDF jobs',
    hub: '/pdf-tools/',
    tools: [
      { name: 'Compress PDF to a size', href: '/compress-pdf/', live: true, note: 'Pick a target and the page works to land under it, showing the exact final size.' },
      { name: 'Compress PDF to 200 KB', href: '/compress-pdf-to-200kb/', live: true, note: 'The tight-portal preset, target already set.' },
      { name: 'Merge PDF', href: '/merge-pdf/', live: true, note: 'Many files, your order, pages copied not rebuilt. 25 files merged in 71 milliseconds on the bench.' },
      { name: 'Split PDF', href: '/split-pdf/', live: true, note: 'A page range as one file, or every page as its own PDF.' },
      { name: 'Read a scan (OCR)', href: '/ocr-pdf/', live: true, note: 'Checkable text plus a searchable PDF, read at 300 DPI.' },
      { name: 'Convert to and from PDF', href: null, live: false, note: 'JPG to PDF, PDF to JPG and the rest are measured and in the build plan; the doors open as each one passes its checks.' },
    ],
  },
  {
    name: 'Image jobs',
    hub: '/image-tools/',
    tools: [
      { name: 'Compress image to exact KB', href: '/compress-image/', live: true, note: 'A photo at the exact size a form or shop asks for, the tool the big sites do not offer.' },
      { name: 'Compress image to 50 KB', href: '/compress-image-to-50kb/', live: true, note: 'The form and seller preset, target already set.' },
      { name: 'Convert and resize', href: null, live: false, note: 'Measured on the bench (our WebP came out smaller than the biggest converter\'s on the same photo) and in the build plan.' },
    ],
  },
  {
    name: 'Check a file',
    hub: '/size-checker/',
    tools: [
      { name: 'Size checker', href: '/size-checker/', live: true, note: 'Exact bytes, real format, dimensions, pages or duration, lined up against the doors portals set.' },
    ],
  },
];
---

<Base title="All tools · Benchzy" description="Every Benchzy tool on one page: background removal, PDF jobs, image jobs and the size checker. Free, no accounts, everything runs in your browser.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Hub · the whole workshop</p>
      <h1 class="font-display text-4xl font-black mt-2">All tools</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        Every tool runs inside your browser, on your device. Files are not uploaded, there are
        no accounts and no daily counters. Tools still being built are listed as what they are,
        in the plan, not dressed up as ready.
      </p>
    </section>

    {families.map((fam) => (
      <section class="mt-10">
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">
          {fam.name} <a class="font-mono text-xs uppercase tracking-widest text-accent-deep underline-offset-4 hover:underline align-middle" href={fam.hub}>family page</a>
        </h2>
        <div class="mt-4 grid gap-4">
          {fam.tools.map((t) => (
            <article class="ticket-soft p-5 flex flex-wrap items-baseline gap-3">
              <h3 class="font-display text-xl font-bold">{t.name}</h3>
              {t.live
                ? <span class="stamp">On the bench</span>
                : <span class="font-mono text-xs uppercase tracking-widest text-ink-soft border border-line px-2 py-1">In the plan</span>}
              <p class="w-full text-ink-soft leading-relaxed">{t.note}</p>
              {t.live && <a class="btn-primary no-underline mt-1" href={t.href}>Open the tool</a>}
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="ticket mt-12 p-6 mb-4">
      <h2 class="font-display text-2xl font-bold">The standing rules, on one page</h2>
      <p class="mt-3 leading-relaxed text-ink-soft max-w-2xl">
        What free means here, the never list, and the one real limit are written out on the
        <a class="underline underline-offset-4" href="/what-free-means/">what free means here</a> page,
        and the no-upload promise can be watched live on the
        <a class="underline underline-offset-4" href="/check-it-yourself/">check it yourself</a> page.
      </p>
    </section>
  </div>
</Base>
