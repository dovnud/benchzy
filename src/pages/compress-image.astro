---
import Base from '../layouts/Base.astro';

const faq = [
  {
    q: 'How exact is the result?',
    a: 'On a normal photo, our bench landed within about half a percent of the target at 200, 100, 50 and 20 KB. The page searches quality and, when quality alone has no setting close enough (which happens on very noisy photos), the dimensions too, and it shows you the exact final size and how far it sits from your target.',
  },
  {
    q: 'Why does the search take a few seconds?',
    a: 'Each try means fully re-encoding the photo, and a big photo takes a moment to encode. The page shows every try and its size as it goes, so you can watch it close in on your target.',
  },
  {
    q: 'What format comes out?',
    a: 'A JPEG, at the dimensions the result line states. The tool is built for the size doors (forms, shops and portals) that ask for a photo under a KB limit.',
  },
  {
    q: 'Where does my photo go?',
    a: 'Nowhere. It is decoded, re-encoded and offered back to you inside this page. Nothing is uploaded.',
  },
];
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const targets = [200, 100, 50];
---

<Base title="Compress an image to an exact KB, free, in your browser · Benchzy" description="Shrink a photo to 200 KB, 100 KB, 50 KB or an exact size you pick, with the work done inside your browser. No upload, no account. The achieved size and its distance from your target are shown.">
  <div class="mx-auto max-w-5xl px-4">
    <section class="mt-8">
      <p class="font-mono text-xs uppercase tracking-widest text-accent-deep">Job ticket · image bench</p>
      <h1 class="font-display text-4xl font-black mt-2">Compress image to exact KB</h1>
      <p class="mt-3 text-lg leading-relaxed max-w-2xl">
        A form wants a photo under 200 KB. A shop wants one under 100 KB. The big converters offer
        a quality slider and leave you guessing. This page takes the target itself and searches
        until it lands there, in your browser, with nothing uploaded.
      </p>
    </section>

    <section class="ticket mt-6 p-5 sm:p-7" id="ci-tool">
      <div id="ci-tray" class="tray p-6 text-center cursor-pointer" role="button" tabindex="0" aria-label="Pick an image">
        <p class="font-display text-xl font-bold">Drop a photo on the tray, or click to pick one</p>
        <p class="font-mono text-xs text-ink-soft mt-2">JPG, PNG or WebP · it stays on this device</p>
        <input id="ci-file" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" class="hidden" />
      </div>

      <div class="grid gap-6 mt-6 md:grid-cols-[1fr_320px]">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">Target size</h2>
          <div id="ci-targets" class="flex gap-2 mt-3 flex-wrap">
            {targets.map((kb) => (
              <button type="button" class="chip" data-kb={kb} aria-pressed="false">{kb} KB</button>
            ))}
          </div>
          <label class="font-mono text-xs uppercase tracking-widest text-ink-soft block mt-5" for="ci-custom">Or your own target (KB)</label>
          <input id="ci-custom" type="number" min="5" max="20000" step="5" class="mt-2 border border-ink bg-ticket px-3 py-2 font-mono w-40" />
          <img id="ci-preview" alt="The compressed result" class="hidden w-full border border-line bg-paper-deep object-contain max-h-72 mt-6" />
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-ink-soft">File spec</h2>
          <dl id="ci-spec" class="mt-2">
            <div class="spec-row"><dt>file</dt><dd>none picked yet</dd></div>
          </dl>
          <button id="ci-run" class="btn-primary w-full mt-5" type="button" disabled>Compress to the target</button>
          <p id="ci-status" class="font-mono text-sm mt-4 leading-relaxed" aria-live="polite">Pick a photo to begin.</p>
        </div>
      </div>

      <div id="ci-result" class="hidden mt-8">
        <div class="tear pt-5 flex items-center gap-4 flex-wrap">
          <h2 class="font-display text-2xl font-bold">Result</h2>
          <span class="stamp" id="ci-stamp">Done on your device</span>
        </div>
        <p id="ci-achieved" class="mt-3 leading-relaxed max-w-2xl"></p>
        <a id="ci-download" class="btn-primary inline-block no-underline mt-3" href="#" download>Download the photo (JPG)</a>
      </div>
    </section>

    <section class="mt-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">How it works</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          The page decodes your photo and runs a search: it encodes at different quality settings,
          watches the sizes, and closes in on your target. On hard photos, quality alone has no
          setting that lands close (the steps jump over the window), so the search then adjusts the
          dimensions too. That combined search is the shipping method here; on the hardest photo on
          our bench it landed within about a third of a percent of the target.
        </p>
      </div>
      <div>
        <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Honest limits</h2>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Very small targets mean a softer or smaller photo; the result line always states the
          quality and dimensions used, so you can judge the trade yourself. If a photo is already
          under your target and already a JPEG, you get it back unchanged. The output is a JPEG,
          which suits the forms and shops this tool is built for.
        </p>
      </div>
    </section>

    <section class="mt-10 mb-4">
      <h2 class="font-display text-2xl font-bold border-b-2 border-ink pb-2">Questions</h2>
      <div class="mt-4 grid gap-4">
        {faq.map((f) => (
          <article class="ticket-soft p-5">
            <h3 class="font-bold">{f.q}</h3>
            <p class="text-ink-soft leading-relaxed mt-1">{f.a}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={faqJson}></script>
  <script>
    import '../scripts/compress-image.js';
  </script>
</Base>
