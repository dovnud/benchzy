---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23faf5ea'/%3E%3Crect x='4' y='4' width='24' height='24' fill='none' stroke='%231b2634' stroke-width='2'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='16' font-weight='bold' text-anchor='middle' fill='%23d9551e'%3EB%3C/text%3E%3C/svg%3E" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b-2 border-ink bg-paper">
      <div class="mx-auto max-w-5xl px-4 py-3 flex items-baseline gap-6 flex-wrap">
        <a href="/" class="font-display text-3xl font-black tracking-tight text-ink no-underline">
          Benchzy<span class="text-accent">.</span>
        </a>
        <span class="font-mono text-xs uppercase tracking-widest text-ink-soft hidden sm:inline">the file workshop</span>
        <nav class="ml-auto flex gap-5 font-mono text-sm">
          <a class="hover:text-accent-deep underline-offset-4 hover:underline" href="/remove-background/">Remove background</a>
          <a class="hover:text-accent-deep underline-offset-4 hover:underline" href="/compress-pdf/">Compress PDF</a>
          <a class="hover:text-accent-deep underline-offset-4 hover:underline" href="/compress-image/">Compress image</a>
          <a class="hover:text-accent-deep underline-offset-4 hover:underline" href="/merge-pdf/">Merge</a>
          <a class="hover:text-accent-deep underline-offset-4 hover:underline" href="/ocr-pdf/">Read a scan</a>
          <a class="hover:text-accent-deep underline-offset-4 hover:underline" href="/size-checker/">Size checker</a>
        </nav>
      </div>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="border-t-2 border-ink mt-16">
      <div class="mx-auto max-w-5xl px-4 py-8 grid gap-6 sm:grid-cols-3 font-mono text-xs leading-relaxed text-ink-soft">
        <div>
          <p class="text-ink font-bold uppercase tracking-widest mb-2">How it works</p>
          <p>Every job runs inside your browser, on your device. Files are not uploaded. There is no server here that could receive them.</p>
        </div>
        <div>
          <p class="text-ink font-bold uppercase tracking-widest mb-2">The standing rules</p>
          <p>No accounts. No sign-up. No daily counters. No watermarks on output. If a tool cannot do a job well, the page says so before you pick a file.</p>
        </div>
        <div>
          <p class="text-ink font-bold uppercase tracking-widest mb-2">Under the counter</p>
          <p>The engines are open-source and run from this site. <a class="underline underline-offset-4 hover:text-accent-deep" href="/credits/">Credits and licences</a>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
