---
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';

interface Alternate {
  hreflang: string;
  href: string;
}
interface Props {
  title: string;
  description: string;
  lang?: string;
  alternates?: Alternate[];
  // Milestone 22: utility pages that must stay out of search (the 404
  // page) pass noindex; every content page leaves it unset.
  noindex?: boolean;
}
const { title, description, lang = 'en', alternates = [], noindex = false } = Astro.props;

// Language seam (milestone 18, round-2 Missing 8): an English page
// that has NO Spanish or Portuguese version of itself (no es / pt-BR
// alternate declared) carries a hidden line at the top of its main
// content. A small inline script shows it, in the visitor's language
// and with a link back, when the visit arrived from the Spanish or
// Portuguese pages. Pages that do declare a translation never render
// the line: they link to their own versions instead.
const hasTranslation = alternates.some((a) => a.hreflang === 'es' || a.hreflang === 'pt-BR');
const showLangNote = lang === 'en' && !hasTranslation;

// Canonical + social cards (milestone 5). The canonical is this page's
// own public URL on the production host; every page is self-referencing.
// OG/Twitter values come from the same title and description props the
// page already passes, so the cards can never drift from the page.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://benchzy.com').href;
const ogImage = new URL('/og.png', Astro.site ?? 'https://benchzy.com').href;
const ogLocale = { en: 'en_US', es: 'es_ES', 'pt-BR': 'pt_BR' }[lang] || 'en_US';

// Page chrome (nav + footer) per locale. en is the source of truth and
// renders exactly what this layout always rendered. The es / pt-BR
// chrome serves the localised background-removal pages; the tools it
// names (other than background removal) are still English pages, so
// those links stay on the English routes. Drafted in-house 2026-11-08,
// PENDING HUMAN REVIEW (TRANSLATIONS.md).
const CHROME = {
  en: {
    tagline: 'the file workshop',
    nav: [
      { label: 'All tools', href: '/tools/' },
      { label: 'Remove background', href: '/remove-background/' },
      { label: 'Compress PDF', href: '/compress-pdf/' },
      { label: 'Compress image', href: '/compress-image/' },
      { label: 'Merge', href: '/merge-pdf/' },
      { label: 'Read a scan', href: '/ocr-pdf/' },
      { label: 'Size checker', href: '/size-checker/' },
    ],
    footHowH: 'How it works',
    footHow: 'Every job runs inside your browser, on your device. Files are not uploaded: they never reach a server. The pages of this site are served by a host, Cloudflare Pages, named on the privacy page.',
    footRulesH: 'The standing rules',
    footRules: 'No accounts. No sign-up. No daily counters. No watermarks on output. If a tool cannot do a job well, the page says so before you pick a file.',
    footFree: 'What free means here',
    footCheck: 'Check it yourself',
    footPrivacy: 'Privacy',
    freeHref: '/what-free-means/',
    checkHref: '/check-it-yourself/',
    footUnderH: 'Under the counter',
    footUnder: 'The engines are open-source and run from this site.',
    footCredits: 'Credits and licences',
    footFineL: 'Benchzy — the file workshop',
    footFineR: 'Files sent to a server: 0',
  },
  es: {
    tagline: 'el taller de archivos',
    nav: [
      { label: 'Todas las herramientas', href: '/tools/' },
      { label: 'Quitar fondo', href: '/es/quitar-fondo-de-imagen-gratis/' },
      { label: 'Comprimir PDF', href: '/compress-pdf/' },
      { label: 'Comprimir imagen', href: '/compress-image/' },
      { label: 'Unir PDF', href: '/merge-pdf/' },
      { label: 'Leer un documento escaneado', href: '/ocr-pdf/' },
      { label: 'Comprobar tamaño', href: '/size-checker/' },
    ],
    footHowH: 'Cómo funciona',
    footHow: 'Cada trabajo se hace dentro de tu navegador, en tu dispositivo. Los archivos no se suben: nunca llegan a un servidor. Las páginas de este sitio las sirve un servicio de hosting, Cloudflare Pages, nombrado en la página de privacidad.',
    footRulesH: 'Las reglas de la casa',
    footRules: 'Sin cuentas. Sin registro. Sin contadores diarios. Sin marcas de agua en el resultado. Si una herramienta no puede hacer bien un trabajo, la página lo dice antes de que elijas un archivo.',
    footFree: 'Qué significa gratis aquí',
    footCheck: 'Compruébalo tú mismo',
    footPrivacy: 'Privacidad',
    freeHref: '/es/que-significa-gratis-aqui/',
    checkHref: '/es/compruebalo-tu-mismo/',
    footUnderH: 'Entre bastidores',
    footUnder: 'Los programas son de código abierto y se cargan desde este sitio.',
    footCredits: 'Créditos y licencias',
    footFineL: 'Benchzy — el taller de archivos',
    footFineR: 'Archivos enviados a un servidor: 0',
  },
  'pt-BR': {
    tagline: 'a oficina de arquivos',
    nav: [
      { label: 'Todas as ferramentas', href: '/tools/' },
      { label: 'Remover fundo', href: '/pt-br/remover-fundo-de-imagem-gratis/' },
      { label: 'Comprimir PDF', href: '/compress-pdf/' },
      { label: 'Comprimir imagem', href: '/compress-image/' },
      { label: 'Juntar', href: '/merge-pdf/' },
      { label: 'Ler digitalização', href: '/ocr-pdf/' },
      { label: 'Verificar tamanho', href: '/size-checker/' },
    ],
    footHowH: 'Como funciona',
    footHow: 'Todo trabalho é feito dentro do seu navegador, no seu aparelho. Os arquivos não são enviados: nunca chegam a um servidor. As páginas deste site são servidas por uma hospedagem, Cloudflare Pages, nomeada na página de privacidade.',
    footRulesH: 'As regras da casa',
    footRules: 'Sem contas. Sem cadastro. Sem contadores diários. Sem marcas d’água no resultado. Se uma ferramenta não consegue fazer bem um trabalho, a página avisa antes de você escolher um arquivo.',
    footFree: 'O que grátis significa aqui',
    footCheck: 'Confira você mesmo',
    footPrivacy: 'Privacidade',
    freeHref: '/pt-br/o-que-significa-gratis/',
    checkHref: '/pt-br/confira-voce-mesmo/',
    footUnderH: 'Nos bastidores',
    footUnder: 'Os mecanismos são de código aberto e rodam a partir deste site.',
    footCredits: 'Créditos e licenças',
    footFineL: 'Benchzy — a oficina de arquivos',
    footFineR: 'Arquivos enviados a um servidor: 0',
  },
};
const c = CHROME[lang] || CHROME.en;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Benchzy" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Benchzy, the file workshop: free file tools that run in your browser" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hreflang} href={a.href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf6ee" />
    {/* Google Analytics visit counter (milestone 19). The standard
        Google tag: it fires once when a page opens and counts the
        visit. It is not part of any tool and is never told anything
        about a visitor's files; the privacy page names it and says
        what it sees, and the check-it-yourself pages list its line
        beside every other request. */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PSWNWPP7PY" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PSWNWPP7PY');
    </script>
    {/* Google AdSense loader (milestone 23). The standard loader for
        this site's one ad network, named on the privacy page in the
        same step that put this line here, as the site promised: the
        network is named before its code runs. It loads once when a
        page opens; it is not part of any tool, it is never told
        anything about a visitor's files, and a tool run calls
        nothing new. The check-it-yourself pages list its line beside
        the counter's, labelled "ad loader". */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1450356163101033" crossorigin="anonymous" is:inline></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="masthead">
      <div class="mast-in">
        <a href="/" class="wordmark" aria-label="Benchzy home">
          <LogoMark size={30} />
          benchzy
          <span class="mast-tag">{c.tagline}</span>
        </a>
        <nav class="mast-nav" aria-label="Main">
          {c.nav.map((n) => (
            <a href={n.href}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-1 w-full">
      {showLangNote && (
        <div class="mx-auto max-w-5xl px-4">
          <p id="bz-lang-note" class="lang-note hidden" role="note"></p>
        </div>
      )}
      {showLangNote && (
        <script is:inline>
          (function () {
            var el = document.getElementById('bz-lang-note');
            if (!el) return;
            var lang = null;
            try { lang = sessionStorage.getItem('bz-visit-lang'); } catch (e) {}
            if (!lang && document.referrer) {
              try {
                var r = new URL(document.referrer);
                if (r.origin === location.origin) {
                  if (r.pathname.indexOf('/es/') === 0) lang = 'es';
                  else if (r.pathname.indexOf('/pt-br/') === 0) lang = 'pt-BR';
                }
              } catch (e) {}
            }
            if (lang === 'es') {
              el.innerHTML = 'Estás en una herramienta en inglés: todavía no tiene versión en español. <a href="/es/que-significa-gratis-aqui/">Volver a las páginas en español →</a>';
            } else if (lang === 'pt-BR') {
              el.innerHTML = 'Você está em uma ferramenta em inglês: ela ainda não tem versão em português. <a href="/pt-br/o-que-significa-gratis/">Voltar para as páginas em português →</a>';
            } else { return; }
            el.classList.remove('hidden');
          })();
        </script>
      )}
      <slot />
    </main>

    <footer class="site-foot">
      <div class="mx-auto max-w-5xl px-4">
        <div class="grid gap-6 sm:grid-cols-3 text-sm leading-relaxed text-ink-soft">
          <div>
            <p class="font-mono text-xs font-semibold text-ink uppercase tracking-widest mb-2">{c.footHowH}</p>
            <p>{c.footHow}</p>
          </div>
          <div>
            <p class="font-mono text-xs font-semibold text-ink uppercase tracking-widest mb-2">{c.footRulesH}</p>
            <p>{c.footRules}</p>
            <p class="mt-2">
              <a class="underline underline-offset-4 hover:text-accent-deep" href={c.freeHref}>{c.footFree}</a> ·
              <a class="underline underline-offset-4 hover:text-accent-deep" href={c.checkHref}>{c.footCheck}</a> ·
              <a class="underline underline-offset-4 hover:text-accent-deep" href="/privacy/">{c.footPrivacy}</a>
            </p>
          </div>
          <div>
            <p class="font-mono text-xs font-semibold text-ink uppercase tracking-widest mb-2">{c.footUnderH}</p>
            <p>{c.footUnder} <a class="underline underline-offset-4 hover:text-accent-deep" href="/credits/">{c.footCredits}</a>.</p>
          </div>
        </div>
        <div class="foot-fine mt-8 border-t border-line pt-4">
          <span>{c.footFineL}</span>
          <span>{c.footFineR}</span>
        </div>
      </div>
    </footer>
    <script is:inline>
      // Language seam (milestone 18): a visit to a Spanish or
      // Portuguese page marks this tab's session, so an English-only
      // tool page reached from there can say so at its top (see the
      // note markup in <main>). Session storage only; nothing is kept
      // past the session and nothing leaves the device.
      try {
        var l = document.documentElement.lang || '';
        if (l.indexOf('es') === 0) sessionStorage.setItem('bz-visit-lang', 'es');
        else if (l.indexOf('pt') === 0) sessionStorage.setItem('bz-visit-lang', 'pt-BR');
      } catch (e) {}
    </script>
    <script is:inline>
      // Repeat-visit caching: pages and engine files this browser has loaded
      // are kept by the service worker, so returning visits skip the big
      // downloads. It caches program files only; it never sees your files.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
